---
projectName: Bratwurst
dependencies:
- https://github.com/wurstscript/wurstStdlib2
buildMapData:
  name: BigSausageDefense # Name shown ingame, may be colored
  fileName: Bratwurst # Name of the map file
  author: DirtyDave # Name of the author
  scenarioData:
    description: WurstScript powered! # The map's description
    suggestedPlayers: "4" # Hint text displayed in lobby
    loadingScreen:
      model: MyModel.mdx # Use 'model' to specify a custom model as loading screen
      background: Generic # Use 'background' to use an existing loading screen
      title: BigSausageDefense
      subTitle: By LGBTQQIP2SAA rep Viki and Dirty Dave
      text: beta
  optionsFlags:
    hideMinimapPreview: false
    forcesFixed: false
    maskedAreasPartiallyVisible: false
    showWavesOnCliffShores: false
    showWavesOnRollingShores: false
    useItemClassificationSystem: false
  players:
  - id: 0
    name: Player 1
    race: HUMAN
    controller: USER
    fixedStartLoc: true
  - id: 1
    name: Player 2
    race: HUMAN
    controller: USER
    fixedStartLoc: false
  - id: 2
    name: Player 3
    race: ORC
    controller: USER
    fixedStartLoc: false
  - id: 3
    name: Player 4
    race: HUMAN
    controller: USER
    fixedStartLoc: true
  - id: 4
    name: Player 5
    race: HUMAN
    controller: USER
    fixedStartLoc: false
  - id: 5
    name: Player 6
    race: ORC
    controller: USER
    fixedStartLoc: true
  - id: 15
    name: Qiraji 1
    race: ORC
    controller: COMPUTER
    fixedStartLoc: false
  - id: 16
    name: Qiraji 2
    race: ORC
    controller: COMPUTER
    fixedStartLoc: false
  forces:
  - name: Druids
    playerIds:
    - 0
    flags:
      allied: true
      alliedVictory: true
      sharedVision: true
      sharedControl: false
      sharedControlAdvanced: false
  - name: Sentinels
    playerIds:
      - 1
    flags:
      allied: true
      alliedVictory: true
      sharedVision: true
      sharedControl: false
      sharedControlAdvanced: false
  - name: Naga
    playerIds:
    - 3
    - 4
    - 5
    flags:
      allied: true
      alliedVictory: true
      sharedVision: true
      sharedControl: false
      sharedControlAdvanced: false
  - name: Qiraji
    playerIds:
    - 15
    - 16
    flags:
      allied: true
      alliedVictory: true
      sharedVision: true
      sharedControl: false
      sharedControlAdvanced: false