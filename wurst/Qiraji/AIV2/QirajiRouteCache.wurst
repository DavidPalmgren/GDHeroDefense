/** Parses ROUTE_DATA_LINES directly into navigationMap/navigationWeights.
    No file I/O involved - safe for online/multiplayer play.
    Whenever new routing is required either due to geographic changes to the map or addition of new controlpoints make sure you,
    take the output file in wurst/qiraji.. (war3 docs custom map data) and update the list above.
     */
public function loadHardcodedRouteData()
    for line in ROUTE_DATA_LINES
        if line != ""
            let parts = line.split(":")
            if parts.size() == 2
                let srcId = parts.get(0).toInt()
                let entries = parts.get(1).split(",")
                if srcId > 0
                    let nodeList = new LinkedList<int>()
                    let weightMap = new HashMap<int, real>()
                    for entry in entries
                        if entry != ""
                            let kv = entry.split("=")
                            if kv.size() == 2
                                let neighborId = kv.get(0).toInt()
                                let weight = kv.get(1).toReal()
                                nodeList.add(neighborId)
                                weightMap.put(neighborId, weight)
                    navigationMap.put(srcId, nodeList)
                    navigationWeights.put(srcId, weightMap)

    print("|cff00ff00QirajiColumbus|r Loaded hardcoded route graph (" + navigationMap.size().toString() + " source nodes)")