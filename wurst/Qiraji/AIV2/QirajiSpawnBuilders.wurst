package QirajiSpawnBuilders

import QirajiBuildingIds
import QirajiWorker 
import QirajiPlacement // Imported: Grabs our newly built layout scanner

public function qirajiSpawnBuildersSetBase(player aiPlayer)
    aiPlayer.setGold(1500)
    aiPlayer.setLumber(10000)
    SetPlayerState(aiPlayer, PLAYER_STATE_FOOD_CAP_CEILING, 200)
    let spawnRect = gg_rct_QirajiSpawn
    let startPos = spawnRect.getCenter() 

    //printTimed("|cff00ffffQIRAJI SPAWN:|r Initializing Silithid Swarm at designated region center.", 5.)

    unit primaryBuilder = null

    for i = 1 to 5
        let offsetPos = startPos + vec2(GetRandomReal(-128, 128), GetRandomReal(-128, 128))
        let drone = CreateUnit(aiPlayer, QIRAJI_WORKER_ID, offsetPos.x, offsetPos.y, GetRandomReal(0, 360))
        
        if i == 1
            primaryBuilder = drone

    if primaryBuilder != null and primaryBuilder.isAlive()
        let buildSite = findValidBuildSite(startPos, 5, 5, 512.0,64)
        
        //printTimed("|cffffcc00QIRAJI SPAWN:|r Issuing priority command to Hive Node genesis vector.", 4.)
        
        primaryBuilder.issuePointOrderById(QIRAJI_T1_HIVE_NODE, buildSite)