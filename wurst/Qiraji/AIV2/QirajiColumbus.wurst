package QirajiColumbus

import ControlPoint
import ControlPointExtension
import HashMap
import LinkedList
import ClosureTimers
import FileIO
import StringUtils

// --- Configuration Constants ---
let PROBE_MAX_RANGE = 8500.0
let ARRIVAL_THRESHOLD = 150.0
let PROBE_TIMEOUT = 120.0
let WISP_UNIT_ID = 'ewsp'    
let PEASANT_UNIT_ID = 'hpea' 
let PROBE_PLAYER_COUNT = 4              // NEW: how many player slots to spread probes across
int probePlayerCycle = 0  
let ROUTE_CACHE_FILE = "wurst/Qiraji/AIV2/QirajiRouteCache.txt"

// --- Navigation Map Storage ---
public let navigationMap = new HashMap<int, LinkedList<int>>()
public let navigationWeights = new HashMap<int, HashMap<int, real>>()   // NEW: edge travel-time weights

int activeProbesCount = 0
bool mappingComplete = false

// --- Structures for Path Tracking ---
class ProbeTracker
    unit probeUnit
    int sourceId
    int targetId
    vec2 targetPos
    real timeElapsed

    construct(int src, int dest, vec2 start, vec2 target)
        sourceId = src
        targetId = dest
        targetPos = target
        timeElapsed = 0.0
        
        // Player(15) is Neutral Passive
        probeUnit = CreateUnit(getNextProbePlayer(), WISP_UNIT_ID, start.x, start.y, 0.0)
        if probeUnit != null
            probeUnit..setInvulnerable(true)
                     ..setMoveSpeed(522)
                     ..issuePointOrder("move", target)
                 
        activeProbesCount++
        
        // Stable periodic timer checking status manually
        doPeriodically(0.5) (CallbackPeriodic cb) ->
            timeElapsed = timeElapsed + 0.5
            if this.checkStatus() or timeElapsed >= PROBE_TIMEOUT
                this.cleanup()
                destroy cb
                destroy this
            
    function getNextProbePlayer() returns player
        let p = players[17 + probePlayerCycle]
        probePlayerCycle = (probePlayerCycle + 1) mod PROBE_PLAYER_COUNT
        return p

    function checkStatus() returns bool
        if probeUnit == null or not probeUnit.isAlive()
            return true 
            
        if probeUnit.getPos().distanceToSq(targetPos) <= ARRIVAL_THRESHOLD * ARRIVAL_THRESHOLD
            registerPath(sourceId, targetId, timeElapsed)   // CHANGED: pass real travel time as weight
            return true
            
        return false

    function cleanup()
        if probeUnit != null
            probeUnit.remove()
            probeUnit = null
        activeProbesCount--
        checkMappingCompletion()

// --- Core Mapping Logic ---

function registerPath(int fromId, int toId, real weight)   // CHANGED: added weight param
    if not navigationMap.has(fromId)
        navigationMap.put(fromId, new LinkedList<int>())
        navigationWeights.put(fromId, new HashMap<int, real>())   // NEW
    
    let neighbors = navigationMap.get(fromId)
    let weights = navigationWeights.get(fromId)                  // NEW
    if not neighbors.has(toId)
        neighbors.add(toId)
        weights.put(toId, weight)                                 // NEW
        print("|cff00ffffQirajiColumbus|r Registered subway link: " + fromId.toString() + " -> " + toId.toString() + " (" + weight.toString() + "s)")
    else if weight < weights.get(toId)                           // NEW: if re-probed faster, keep the better time
        weights.put(toId, weight)

function buildNavigationMapText() returns string
    var output = "Qiraji route graph\n"
    var srcId = 1
    while srcId <= 67
        let neighbors = navigationMap.get(srcId)
        let weights = navigationWeights.get(srcId)              // NEW
        if neighbors != null and not neighbors.isEmpty()
            output += srcId.toString() + ":"
            var idx = 0
            while idx < neighbors.size()
                let n = neighbors.get(idx)
                output += n.toString() + "=" + weights.get(n).toString()   // CHANGED: neighbor=weight
                if idx < neighbors.size() - 1
                    output += ","
                idx++
            output += "\n"
        srcId++
    return output

function printReadableNavigationMap()
    let rendered = buildNavigationMapText()
    if rendered == "Qiraji route graph\n"
        print("|cffff0000QirajiColumbus|r No navigation links were recorded yet.")
        return

    print("|cff00ffffQirajiColumbus|r Cached route graph:")
    let lines = rendered.split("\n")
    for line in lines
        if line != ""
            print(line)

function saveNavigationMap()
    let output = buildNavigationMapText()

    new File(ROUTE_CACHE_FILE)..write(localPlayer, output)..close()
    print("|cff00ff00QirajiColumbus|r Saved probe explorer results to " + ROUTE_CACHE_FILE)
    printReadableNavigationMap()

function loadNavigationMap() returns bool
    let cached = new File(ROUTE_CACHE_FILE).readAsString(localPlayer)
    if cached == null or cached == ""
        return false

    let lines = cached.split("\n")
    for line in lines
        if line != ""
            let parts = line.split(":")
            if parts.size() == 2
                let srcId = parts.get(0).toInt()
                let entries = parts.get(1).split(",")
                if srcId > 0
                    let nodeList = new LinkedList<int>()
                    let weightMap = new HashMap<int, real>()      // NEW
                    for entry in entries
                        if entry != ""
                            let kv = entry.split("=")             // NEW: split "neighbor=weight"
                            if kv.size() == 2
                                let neighborId = kv.get(0).toInt()
                                let weight = kv.get(1).toReal()
                                nodeList.add(neighborId)
                                weightMap.put(neighborId, weight)
                    navigationMap.put(srcId, nodeList)
                    navigationWeights.put(srcId, weightMap)       // NEW

    print("|cff00ff00QirajiColumbus|r Loaded probe explorer results from " + ROUTE_CACHE_FILE)
    return true

public function beginAutomatedMapping()
    print("|cff00ff00QirajiColumbus: Initializing Subway Mapping Probes...|r")
    
    // Explicit while loops eliminate ANTLR parser crashes completely
    var srcId = 1
    while srcId <= 67
        let srcUnit = cpRegistry.get(srcId)
        if srcUnit != null
            let srcPos = srcUnit.getPos()
            
            var destId = 1
            while destId <= 67
                if srcId != destId
                    let destUnit = cpRegistry.get(destId)
                    if destUnit != null
                        let destPos = destUnit.getPos()
                        let distance = srcPos.distanceTo(destPos)
                        
                        if distance <= PROBE_MAX_RANGE
                            new ProbeTracker(srcId, destId, srcPos, destPos)
                destId++
        srcId++
                
    if activeProbesCount == 0
        print("|cffff0000Mapping failed: No valid control point pairs found within range.|r")

function checkMappingCompletion()
    if activeProbesCount == 0 and not mappingComplete
        mappingComplete = true
        print("|cff00ffffSubway Breadcrumb Map Complete! Proceeding to Peasant Test...|r")
        print("|cffffaa00QirajiColumbus|r Navigation graph ready: " + navigationMap.size().toString() + " source nodes registered")
        saveNavigationMap()
        startPeasantPathingTest()

// --- Pathfinding & Testing Engine ---

class WaypointNavigator
    unit traveler = null
    LinkedList<int> pathNodeIds = null
    CallbackPeriodic movementTimer = null
    vec2 currentTargetPos = vec2(0, 0)
    int currentTargetNodeId = -1

    construct(unit u, LinkedList<int> path)
        traveler = u
        pathNodeIds = path
        
        doAfter(0.05) ->
            this.startNavigation()

    function startNavigation()
        if pathNodeIds == null or pathNodeIds.isEmpty()
            print("|cffff0000QirajiColumbus|r Waypoint navigator started with no path nodes")
            this.cleanupAndDestroy()
        else
            this.findNextValidTarget()
            
            if currentTargetPos.x == 0.0 and currentTargetPos.y == 0.0
                print("|cffff0000QirajiColumbus|r Waypoint navigator could not resolve a valid target from the path")
                this.cleanupAndDestroy()
            else
                print("|cff00ffffQirajiColumbus|r Starting waypoint navigator for target " + (currentTargetNodeId != -1 ? getControlPointLabel(currentTargetNodeId) : currentTargetPos.toString()))
                traveler.issuePointOrder("move", currentTargetPos)
                
                movementTimer = doPeriodically(0.5) (CallbackPeriodic cb) ->
                    this.onTimerTick()

    function onTimerTick()
        if traveler == null or not traveler.isAlive()
            this.cleanupAndDestroy()
        else
            if traveler.getPos().distanceToSq(currentTargetPos) <= ARRIVAL_THRESHOLD * ARRIVAL_THRESHOLD
                this.findNextValidTarget()
                
                if not (currentTargetPos.x == 0.0 and currentTargetPos.y == 0.0)
                    print("|cff00ffffQirajiColumbus|r Reached route target, advancing to the next station " + (currentTargetNodeId != -1 ? getControlPointLabel(currentTargetNodeId) : currentTargetPos.toString()))
                    traveler.issuePointOrder("move", currentTargetPos)
                else
                    print("|cff00ff00Test Peasant successfully completed the subway circuit!|r")
                    this.cleanupAndDestroy()

    function findNextValidTarget()
        currentTargetPos = vec2(0, 0)
        currentTargetNodeId = -1
        var found = false
        
        while not pathNodeIds.isEmpty() and not found
            let lastIndex = pathNodeIds.size() - 1
            let nextNodeId = pathNodeIds.get(lastIndex)
            pathNodeIds.removeAt(lastIndex)
            
            let targetUnit = cpRegistry.get(nextNodeId)
            if targetUnit != null
                currentTargetPos = targetUnit.getPos()
                currentTargetNodeId = nextNodeId
                print("|cff00ffffQirajiColumbus|r Route target resolved to " + getControlPointLabel(nextNodeId))
                found = true

    function cleanupAndDestroy()
        if movementTimer != null
            destroy movementTimer
            movementTimer = null
        destroy this

    ondestroy
        if pathNodeIds != null
            destroy pathNodeIds
            pathNodeIds = null

// CHANGED: Dijkstra's algorithm (was BFS) - now finds the fastest route by total travel time, not fewest hops
public function calculateSubwayPath(int startId, int endId) returns LinkedList<int>
    let dist = new HashMap<int, real>()
    let parentMap = new HashMap<int, int>()
    let visited = new HashMap<int, bool>()
    let frontier = new LinkedList<int>()..add(startId)
    dist.put(startId, 0.0)
    var pathFound = false

    while not frontier.isEmpty()
        // Pick the unvisited frontier node with the smallest known distance
        var bestIdx = 0
        var bestId = frontier.get(0)
        var bestDist = dist.get(bestId)
        var idx = 1
        while idx < frontier.size()
            let candidate = frontier.get(idx)
            let candidateDist = dist.get(candidate)
            if candidateDist < bestDist
                bestDist = candidateDist
                bestId = candidate
                bestIdx = idx
            idx++
        frontier.removeAt(bestIdx)

        if visited.has(bestId)
            continue
        visited.put(bestId, true)

        if bestId == endId
            pathFound = true
            break

        let neighbors = navigationMap.get(bestId)
        let weights = navigationWeights.get(bestId)
        if neighbors != null
            var nIdx = 0
            while nIdx < neighbors.size()
                let neighbor = neighbors.get(nIdx)
                if not visited.has(neighbor)
                    let edgeWeight = weights.get(neighbor)
                    let newDist = bestDist + edgeWeight
                    if not dist.has(neighbor) or newDist < dist.get(neighbor)
                        dist.put(neighbor, newDist)
                        parentMap.put(neighbor, bestId)
                        if not frontier.has(neighbor)
                            frontier.add(neighbor)
                nIdx++

    destroy frontier
    destroy visited
    destroy dist

    if not pathFound
        destroy parentMap
        return null

    let path = new LinkedList<int>()
    var backtrackId = endId
    while backtrackId != startId
        path.add(backtrackId) 
        backtrackId = parentMap.get(backtrackId)
    
    destroy parentMap
    return path

function startPeasantPathingTest()
    let startTestNode = 41 // Silithus: Cenarion Enclave
    let endTestNode = 32   // Feralas: Feathermoon Stronghold

    print("|cff00ffffInitiating Direct Subway Route Test (ID: 41 -> ID: 32)...|r")

    let path = calculateSubwayPath(startTestNode, endTestNode)
    let startUnit = cpRegistry.get(startTestNode)
    if path == null
        print("DEBUG: calculateSubwayPath(41,32) returned null - no route in navigationMap")
    if startUnit == null
        print("DEBUG: cpRegistry.get(41) returned null - control point not registered")

    if path != null and startUnit != null
        let startPos = startUnit.getPos()
        
        let peasant = CreateUnit(Player(15), PEASANT_UNIT_ID, startPos.x, startPos.y, 0.0)
        peasant..setInvulnerable(true)
               ..setMoveSpeed(522.0)
        
        // CHANGED: build path string + total ETA using stored edge weights
        var totalTime = 0.0
        var pathStr = ""
        var prevId = startTestNode
        var idx = path.size() - 1
        while idx >= 0
            let nodeId = path.get(idx)
            totalTime += navigationWeights.get(prevId).get(nodeId)
            pathStr = pathStr + nodeId.toString()
            if idx > 0
                pathStr = pathStr + " -> "
            prevId = nodeId
            idx--
            
        print("|cff00ff00Route Calculated:|r " + pathStr + " |cffaaaaaa[~" + R2S(totalTime) + "s]|r")
        
        new WaypointNavigator(peasant, path)
    else
        print("|cffff0000Pathing test broken: Navigation network returned null or registry missing anchors.|r")
        if path != null
            destroy path

// --- Chat Command: -proute <src> <dest> ---

function spawnPeasantRoute(int srcId, int destId)
    if not cpRegistry.has(srcId)
        print("|cffff0000QirajiColumbus|r Unknown source control point ID: " + srcId.toString())
        return

    if not cpRegistry.has(destId)
        print("|cffff0000QirajiColumbus|r Unknown destination control point ID: " + destId.toString())
        return

    if srcId == destId
        print("|cffffaa00QirajiColumbus|r Source and destination are the same node.")
        return

    let path = calculateSubwayPath(srcId, destId)
    let startUnit = cpRegistry.get(srcId)

    if path == null
        print("|cffff0000QirajiColumbus|r No route found from " + srcId.toString() + " to " + destId.toString())
        return

    let startPos = startUnit.getPos()
    let peasant = CreateUnit(Player(15), PEASANT_UNIT_ID, startPos.x, startPos.y, 0.0)
    peasant..setInvulnerable(true)
           ..setMoveSpeed(522.0)

    var totalTime = 0.0
    var pathStr = srcId.toString()
    var prevId = srcId
    var idx = path.size() - 1
    while idx >= 0
        let nodeId = path.get(idx)
        totalTime += navigationWeights.get(prevId).get(nodeId)
        pathStr = pathStr + " -> " + nodeId.toString()
        prevId = nodeId
        idx--

    print("|cff00ff00QirajiColumbus|r Dispatching peasant " + srcId.toString() + " -> " + destId.toString() + 
          " |cffaaaaaa[~" + R2S(totalTime) + "s]|r : " + pathStr)

    new WaypointNavigator(peasant, path)

function onProuteChatCommand()
    let chatStr = GetEventPlayerChatString()
    let parts = chatStr.split(" ")

    if parts.size() != 3
        print("|cffffaa00QirajiColumbus|r Usage: -proute <sourceId> <destId>")
        return

    let srcId = parts.get(1).toInt()
    let destId = parts.get(2).toInt()

    if srcId == 0 or destId == 0
        print("|cffff0000QirajiColumbus|r Invalid IDs. Usage: -proute <sourceId> <destId>")
        return

    spawnPeasantRoute(srcId, destId)

function registerProuteChatCommand()
    let t = CreateTrigger()
    var i = 0
    while i < bj_MAX_PLAYERS
        TriggerRegisterPlayerChatEvent(t, Player(i), "-proute", false)
        i++
    TriggerAddAction(t, function onProuteChatCommand)

// --- Chat Command: -route <src> <dest> ---

function printRouteCommand(int srcId, int destId)
    if not cpRegistry.has(srcId)
        print("|cffff0000QirajiColumbus|r Unknown source control point ID: " + srcId.toString())
        return

    if not cpRegistry.has(destId)
        print("|cffff0000QirajiColumbus|r Unknown destination control point ID: " + destId.toString())
        return

    if srcId == destId
        print("|cffffaa00QirajiColumbus|r Source and destination are the same node.")
        return

    let path = calculateSubwayPath(srcId, destId)

    if path == null
        print("|cffff0000QirajiColumbus|r No route found from " + srcId.toString() + " to " + destId.toString())
        return

    // CHANGED: include total ETA
    var totalTime = 0.0
    var pathStr = srcId.toString()
    var prevId = srcId
    var idx = path.size() - 1
    while idx >= 0
        let nodeId = path.get(idx)
        totalTime += navigationWeights.get(prevId).get(nodeId)
        pathStr = pathStr + " -> " + nodeId.toString()
        prevId = nodeId
        idx--

    print("|cff00ff00QirajiColumbus Route (" + srcId.toString() + " -> " + destId.toString() + 
          "):|r " + pathStr + " |cffaaaaaa[~" + R2S(totalTime) + "s]|r")
    destroy path

function onRouteChatCommand()
    let chatStr = GetEventPlayerChatString()
    let parts = chatStr.split(" ")

    if parts.size() != 3
        print("|cffffaa00QirajiColumbus|r Usage: -route <sourceId> <destId>")
        return

    let srcId = parts.get(1).toInt()
    let destId = parts.get(2).toInt()

    if srcId == 0 or destId == 0
        print("|cffff0000QirajiColumbus|r Invalid IDs. Usage: -route <sourceId> <destId>")
        return

    printRouteCommand(srcId, destId)

function registerRouteChatCommand()
    let t = CreateTrigger()
    var i = 0
    while i < bj_MAX_PLAYERS
        TriggerRegisterPlayerChatEvent(t, Player(i), "-route", false)
        i++
    TriggerAddAction(t, function onRouteChatCommand)


// For any fool that wishes to touch this, loadnavigation map loads a LOCAL cache file not any file inside the actual map or these directorys.
// If you want to update the pathing map you will have to comment out the loadNavigationMap and call beginAutomatedMapping.
// For online play we will instead hardcode a built map manually. Look at the file inside your wc3 document custom map data folder, look for wurst/qiraji/aiv2/qirajiroutecache.txt and you will see the map that was generated. You can edit it manually if you want to add/remove links, but be careful as it is easy to break the pathing if you do not know what you are doing.
// This will be a fucking mess if used online currently and it's not meant to be anything but developer scaffholding.
init
    doAfter(1.0) ->
        registerRouteChatCommand()
        registerProuteChatCommand()
        //beginAutomatedMapping()

        if loadNavigationMap()
            mappingComplete = true
            print("|cff00ffffSubway Breadcrumb Map loaded from cache. Skipping probe rerun.|r")
            startPeasantPathingTest()
        else
            print("Mapping cache not found. Starting probe exploration...")
            beginAutomatedMapping()