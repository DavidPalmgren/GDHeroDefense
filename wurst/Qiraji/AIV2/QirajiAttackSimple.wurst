package QirajiAttackSimple

import ClosureTimers
import ClosureForGroups
import QirajiWorker
import LinkedList
import QirajiBuildingIds
import OrderIds

import QirajiRatsInChat

// Longer interval gives units time to actually path and arrive
constant real ATTACK_INTERVAL = 5.0
// How far units spread around the target to avoid pathing congestion
constant real DESTINATION_SPREAD = 350.0
// Delay between each unit order to avoid flooding the pathfinder
constant real ORDER_STAGGER = 0.1

unit currentTargetCP = null

public function startQirajiAttackLoop(player aiPlayer)
    doPeriodically(ATTACK_INTERVAL) cb ->
        if baseIsUnderAttack
            //printTimed("[QirajiAttack] Base under attack — holding attack orders.", 8.)
            return
        
          
        let baseCenter = gg_rct_QirajiSpawn.getCenter()

        let controlPoints = new LinkedList<unit>()
        let g = CreateGroup()
        GroupEnumUnitsInRect(g, bj_mapInitialPlayableArea, null)
        for u from g
            if u.getOwner() != aiPlayer
                and u.getIcon() == "ReplaceableTextures\\CommandButtons\\BTNCOP.blp"
                controlPoints.add(u)

        //printTimed("[QirajiAttack] Enemy CPs found: " + controlPoints.size().toString(), 10.)

        // Find two closest CPs so we can split the army
        unit targetCP1 = null
        unit targetCP2 = null
        var closestDist1 = REAL_MAX
        var closestDist2 = REAL_MAX

        for cp in controlPoints
            let dist = baseCenter.distanceTo(cp.getPos())
            if dist < closestDist1
                closestDist2 = closestDist1
                targetCP2    = targetCP1
                closestDist1 = dist
                targetCP1    = cp
            else if dist < closestDist2
                closestDist2 = dist
                targetCP2    = cp

        destroy controlPoints

        if targetCP1 == null
            //printTimed("[QirajiAttack] No target CP found — skipping attack.", 10.)
            currentTargetCP = null
            return

        let sameTarget = targetCP1 == currentTargetCP
        currentTargetCP = targetCP1

        // printTimed("[QirajiAttack] Primary target: "
        //     + targetCP1.getPos().x.toString() + "," + targetCP1.getPos().y.toString()
        //     + " | same as last tick: " + sameTarget.toString(), 10.)

        // Collect units that need orders — only truly idle/stopped units if target unchanged
        let combatants = new LinkedList<unit>()
        forUnitsOfPlayer(aiPlayer) (unit u) ->
            if u.isAlive()
                and not u.isType(UNIT_TYPE_STRUCTURE)
                and u.getTypeId() != QIRAJI_WORKER_ID
                if not sameTarget
                    or u.getCurrentOrder() == 0
                    or u.getCurrentOrder() == OrderIds.stop
                    or u.getCurrentOrder() == OrderIds.holdposition
                    combatants.add(u)

        // printTimed("[QirajiAttack] Combatants to order: " + combatants.size().toString(), 10.)

        // Split army — first half goes to primary CP, second half to secondary if available
        let total     = combatants.size()
        var unitIndex = 0
        var delay     = 0.0

        for u in combatants
            let captured   = u
            let goToFirst  = targetCP2 == null or unitIndex < total / 2
            let baseTarget = goToFirst ? targetCP1.getPos() : targetCP2.getPos()

            // Spread destination so units don't all converge on the same cell
            let spread = baseTarget.polarOffset(
                GetRandomReal(0, 360).fromDeg(),
                GetRandomReal(0, DESTINATION_SPREAD)
            )

            // Stagger orders to avoid flooding the pathfinder all at once
            doAfter(delay) ->
                captured.issuePointOrder("attack", spread)

            delay     += ORDER_STAGGER
            unitIndex++

        destroy combatants