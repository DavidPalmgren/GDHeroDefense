package QirajiAI

import ClosureTimers
import QirajiSpawnBuilders
import QirajiFarmManagement // Imported: Connects the supply monitor module
import QirajiT1SetBuildings
import QirajiTrainUnits
import QirajiUpgradesManagement
import QirajiRatsInChat
import QirajiNextTier
import QirajiFlyerControlPointCheese
import QirajiAttackGroups
import QirajiColumbusAttack
import QirajiSouthernSupremacy

import V2QirajiBuild

public function startQirajiGoldIncome(player aiPlayer)
    doPeriodically(60.0) cb ->
        aiPlayer.addGold(100)
        printTimed("[QirajiIncome] +300 gold delivered. Total: " + aiPlayer.getGold().toString(), 5.)

init
    
    doAfter(0.5) ->
        // 1 time called throwaways and own loop here
        let qirajiAIPlayer = players[15]
        startQirajiGoldIncome(qirajiAIPlayer) // base income of 100gpm
        startSubwayAttackSupervisor(4.0)
        // [QUEST]
        startSouthernSupremacyMonitor(qirajiAIPlayer) //60s loop check for reserach
        
        // Step 1: Spawn initial Workers
        qirajiSpawnBuildersSetBase(qirajiAIPlayer)
        startQirajiTierProgression(qirajiAIPlayer)
        //startQirajiBaseDefense(qirajiAIPlayer)
        //startQirajiAttackLoop(qirajiAIPlayer)
        startRecruitmentLoop(qirajiAIPlayer)
        
        // Centralized monitoring loops
        doPeriodically(5.0) (CallbackPeriodic cb) ->
            manageQirajiBarracksV2(qirajiAIPlayer)
            manageQirajiAltar(qirajiAIPlayer)
            startQirajiTrainLoop(qirajiAIPlayer)
            manageQirajiBlacksmithsV2(qirajiAIPlayer)
            manageQirajiAltarV2(qirajiAIPlayer)
            manageBlacksmithResearch(qirajiAIPlayer)
            if qirajiAIPlayer.getMaxSupply() >= 200 and qirajiAIPlayer.getCurrentSupply() >= 200
                // Clean up loop handle if the AI completely maxes its capabilities
                print("Destroying the loop")
                destroy cb
            else
                manageQirajiSupply(qirajiAIPlayer)
            
            // T2
            startQirajiFlyerCheese(qirajiAIPlayer)