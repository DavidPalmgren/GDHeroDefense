package V2QirajiBuild

import QirajiBuildingIds
import QirajiWorkersUnion
import ClosureTimers

/** Helper utility to check if a specific World Editor region is already 
    occupied by a living building of a specific type. */
function isSiteEmpty(rect siteRect, int buildingTypeId, player aiPlayer) returns bool
    let checkGroup = CreateGroup()
    checkGroup.enumUnitsInRect(siteRect, null)
    
    var isEmpty = true
    for u from checkGroup
        if u.getTypeId() == buildingTypeId and u.isAlive() and u.getOwner() == aiPlayer
            isEmpty = false
            break
            
    checkGroup.destr()
    return isEmpty

// ============================================================================
public function manageQirajiBarracksV2(player aiPlayer)
    rect targetSite = null

    if isSiteEmpty(gg_rct_Barracks1, QIRAJI_HATCHERY, aiPlayer)
        targetSite = gg_rct_Barracks1
    else if isSiteEmpty(gg_rct_Barracks2, QIRAJI_HATCHERY, aiPlayer)
        targetSite = gg_rct_Barracks2

    if targetSite == null
        return

    let builder = getAvailableQirajiWorker(aiPlayer)
    if builder == null
        return

    let buildSite = targetSite.getCenter()
    
    scatterIdleUnitsNear(buildSite, builder, aiPlayer, 256.0)
    builder.issuePointOrderById(QIRAJI_HATCHERY, buildSite)


