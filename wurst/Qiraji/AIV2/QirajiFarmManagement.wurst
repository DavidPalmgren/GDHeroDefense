package QirajiFarmManagement

import QirajiBuildingIds
import QirajiPlacement 
import QirajiWorkersUnion 

constant int FOOD_BUFFER = 30 
constant int MAP_MAX_FOOD = 200     

// BUGGY, REWORK LATER AND REMOVE THIS COMMENT

public function manageQirajiSupply(player aiPlayer)
    let foodUsed = aiPlayer.getCurrentSupply()
    let foodCap = aiPlayer.getMaxSupply()

    if foodCap < MAP_MAX_FOOD and (foodCap - foodUsed) <= FOOD_BUFFER
        // Shift your search root to the center of your designated FarmArea rect
        let farmAreaCenter = gg_rct_FarmArea.getCenter()
        
        var firstFarmSite = ZERO2
        var farmsOrdered = 0
        
        // DUAL CONSTRUCTION LOOP
        for i = 1 to 2
            let builder = getAvailableQirajiWorker(aiPlayer)
            
            if builder != null
                // If it's the second farm, offset slightly from the center to avoid building overlaps
                let searchOrigin = (farmsOrdered == 0) ? farmAreaCenter : farmAreaCenter + vec2(256.0, 0.0)
                
                // Find a valid build site centered around our FarmArea
                var buildSite = findValidBuildSite(searchOrigin, 2, 2, 512.0, 128.0)
                
                // Extra safety check: Ensure the found site actually landed inside the FarmArea bounds
                if not gg_rct_FarmArea.contains(buildSite)
                    // If the pathing search leaked out of the rect, force a random location explicitly inside the rect
                    let minX = gg_rct_FarmArea.getMinX() + 128.0
                    let maxX = gg_rct_FarmArea.getMaxX() - 128.0
                    let minY = gg_rct_FarmArea.getMinY() + 128.0
                    let maxY = gg_rct_FarmArea.getMaxY() - 128.0
                    buildSite = vec2(GetRandomReal(minX, maxX), GetRandomReal(minY, maxY))
                
                // Double check second farm distance to prevent stacking issues
                if farmsOrdered == 1 and buildSite.distanceTo(firstFarmSite) < 256.0
                    let alternateOrigin = farmAreaCenter + vec2(-256.0, 0.0)
                    buildSite = findValidBuildSite(alternateOrigin, 2, 2, 512.0, 128.0)
                
                // Validate and command the builder
                if buildSite != ZERO2
                    scatterIdleUnitsNear(buildSite, builder, aiPlayer, 300.0)
                    builder.issuePointOrderById(QIRAJI_SPAWNING_SAC, buildSite)
                    
                    if farmsOrdered == 0
                        firstFarmSite = buildSite
                        
                    farmsOrdered++