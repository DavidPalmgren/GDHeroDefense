package QirajiFarmManagement

import QirajiBuildingIds
import QirajiPlacement 
import QirajiWorkersUnion 

constant int FOOD_BUFFER = 30 
constant int MAP_MAX_FOOD = 200     



public function manageQirajiSupply(player aiPlayer)

    let foodUsed = aiPlayer.getCurrentSupply()
    let foodCap = aiPlayer.getMaxSupply()
    //print("Food used: " + foodUsed.toString())
    //print("Food Cap: " + foodCap.toString())

    // 80 < 100 |                  80 -67 = 13 <= 30
    if foodCap < MAP_MAX_FOOD and (foodCap - foodUsed) <= FOOD_BUFFER
        let baseCenter = gg_rct_QirajiSpawn.getCenter()
        
        var firstFarmSite = ZERO2
        var farmsOrdered = 0
        
        // DUAL CONSTRUCTION LOOP
        for i = 1 to 2
            let builder = getAvailableQirajiWorker(aiPlayer)
            
            if builder != null
                let searchOrigin = (farmsOrdered == 0) ? baseCenter : firstFarmSite + vec2(352.0, 352.0)
                
                var buildSite = findValidBuildSite(searchOrigin, 2, 2, 1024.0, 128.0)
                
                if farmsOrdered == 1 and buildSite.distanceTo(firstFarmSite) < 352.0
                    let alternateOrigin = firstFarmSite + vec2(-352.0, -352.0)
                    buildSite = findValidBuildSite(alternateOrigin, 2, 2, 1024.0, 128.0)
                
                // Validate that a clean site was actually discovered
                if buildSite != baseCenter and (farmsOrdered == 0 or buildSite.distanceTo(firstFarmSite) >= 352.0)
                    // printTimed("|cffffcc00QIRAJI AI:|r Low food capacity! Creating FARM [" + i.toString() + "].", 4.)
                    
                    scatterIdleUnitsNear(buildSite, builder, aiPlayer, 300.0)
                    builder.issuePointOrderById(QIRAJI_SPAWNING_SAC, buildSite)
                    
                    if farmsOrdered == 0
                        firstFarmSite = buildSite
                        
                    farmsOrdered++
                    