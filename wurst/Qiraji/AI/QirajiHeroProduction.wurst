package QirajiHeroProduction

import ClosureEvents
import UnitIds
import ClosureTimers

import QirajiBuildingIds
import CryptLord

constant int ABIL_CARAPACE = 'Ausr'

int array qirajiSkillBuild
// Keep a global reference to the AI's hero so we can easily track if they are alive
unit qirajiFactionHero = null

function initializeSkillBlueprint()
  // Level 1-5 Baseline Progression
  qirajiSkillBuild[1] = CRYPT_LORD_BURROW
  qirajiSkillBuild[2] = ABIL_CARAPACE
  qirajiSkillBuild[3] = CRYPT_LORD_IMPALE
  qirajiSkillBuild[4] = ABIL_CARAPACE
  qirajiSkillBuild[5] = CRYPT_LORD_IMPALE

  // Level 6 Ultimate Milestone
  qirajiSkillBuild[6] = CRYPT_LORD_SUMMON

  // Level 7-10 Late Game Maxing
  qirajiSkillBuild[7] = ABIL_CARAPACE
  qirajiSkillBuild[8] = CRYPT_LORD_IMPALE
  qirajiSkillBuild[9] = CRYPT_LORD_BURROW
  qirajiSkillBuild[10] = CRYPT_LORD_BURROW

/** Attempts to order a living altar to train/revive the hero. Returns true if successful. */
function tryTrainHero(player owner) returns bool
  let altars = CreateGroup()
  altars.enumUnitsOfPlayer(owner, null)

  var ordered = false
  for altar from altars
    if altar.getTypeId() == QIRAJI_ALTAR_OF_THE_OLD and altar.isAlive() and not ordered
      // Ensure the altar isn't already actively training/reviving something
      if altar.getCurrentOrder() == 0
        ordered = altar.issueImmediateOrderById(CRYPT_LORD_HERO_ID)
  
  altars.destr()
  return ordered

init
  initializeSkillBlueprint()

  // 1. Track the hero when they are successfully created/revived
  EventListener.add(EVENT_PLAYER_UNIT_TRAIN_FINISH) ->
    let trained = GetTrainedUnit()
    if trained.getTypeId() == CRYPT_LORD_HERO_ID
      qirajiFactionHero = trained

  // 2. Automatic Skill Allocation
  EventListener.add(EVENT_PLAYER_HERO_LEVEL) ->
    let hero = GetTriggerUnit()
    if hero.getTypeId() == CRYPT_LORD_HERO_ID
      let currentLevel = hero.getLevel()
      if currentLevel <= 10
        let targetSkillId = qirajiSkillBuild[currentLevel]
        
        if targetSkillId != 0
          SelectHeroSkill(hero, targetSkillId)

  // 3. Persistent production manager loop
  // This replaces the fragile one-time events and forces production if resource/food blocked
  doPeriodically(5.0) (cb) ->
    // Assuming player 1 (index 0) is your AI player. Adjust the player index as needed!
    let aiPlayer = players[0] 

    // Conditions to request a hero:
    // - The hero variable was never assigned (initial game state)
    // - The hero exists but is dead, and isn't currently queuing a revival
    let needsInitialTrain = (qirajiFactionHero == null)
    let needsRevive = (qirajiFactionHero != null and not qirajiFactionHero.isAlive())

    if needsInitialTrain or needsRevive
      // Try to train. If resources open up and it succeeds, it returns true.
      tryTrainHero(aiPlayer)