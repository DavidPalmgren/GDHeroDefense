package QirajiColosus

import AbilityObjEditing
import AbilityIds
import UnitObjEditing
import ObjectIds
import ObjectIdGenerator
import BuffObjEditing
import BuffIds
import UnitIds
import ClosureForGroups
import RegisterEvents
import ChannelAbilityPreset
import Unit
import DummyCaster

import ClosureEvents
import ClosureTimers
import EffectUtils

import Icons
import LinkedList

public constant QIRAJI_COLOSUS_ID           = compiletime(UNIT_ID_GEN.next())
public constant QIRAJI_COLOSUS_TRAMPLE_ID      = compiletime(ABIL_ID_GEN.next())
public constant QIRAJI_COLOSUS_TRAMPLE_BUFF_ID = compiletime(BUFF_ID_GEN.next())
public constant QIRAJI_COLOSUS_PHASE_ID        = compiletime(ABIL_ID_GEN.next())
public constant QIRAJI_COLOSUS_CHARGE_ID        = compiletime(ABIL_ID_GEN.next())
var dustDistanceTracker = 0.0 

public constant QIRAJI_COLOSUS_CHARGE_INDICATOR_ID = compiletime(UNIT_ID_GEN.next())

constant real WINDUP_TIME          = 3.0
constant real CHARGE_SPEED         = 1500.0
constant real DAMAGE_AOE           = 300.0
constant real DAMAGE_AMOUNT        = 70.0
constant real INDICATOR_SPACING    = 120.0

constant string PATH_INDICATOR_MODEL = "Skill_Indicator_Straight.mdx"
constant real TRAMPLE_INTERVAL = 0.1
constant real TRAMPLE_RADIUS   = 290.
constant real TRAMPLE_DPS      = 60.0

class TrampleTracker
    private unit colosus
    private vec2 lastPos
    private CallbackPeriodic cb

    construct(unit colosus)
        this.colosus = colosus
        this.lastPos = colosus.getPos()
        
        this.cb = doPeriodically(TRAMPLE_INTERVAL) (CallbackPeriodic cb) ->
            this.tick()

    private function tick()
        if not colosus.isAlive()
            destroy this
            return

        let currentPos = colosus.getPos()
        
        if currentPos.distanceToSq(lastPos) > 0.5
            damageNearbyEnemies(colosus)

        this.lastPos = currentPos

    ondestroy
        destroy cb

@compiletime function genColosus()
    new UnitDefinition(QIRAJI_COLOSUS_ID, UnitIds.nerubianwarrior)
    ..setName("Colossus")
    ..setTooltipBasic("Train Colossus")
    ..setTooltipExtended("The Colossus is a linebreaking tank possessing phased movement and trample.")
    ..setHitPointsMaximumBase(1800)
    ..setDefenseBase(4)
    ..setAttack1DamageBase(33)
    ..setSpeedBase(300)
    ..setCollisionSize(0)
    ..setNormalAbilities(commaList(QIRAJI_COLOSUS_PHASE_ID, AbilityIds.ghostVisible, QIRAJI_COLOSUS_CHARGE_ID))
    ..setModelFile("LordKri.mdx")
    ..setIconGameInterface(Icons.bTNNerubian)
    ..setSelectionScale(2.)
    ..setAttack1Range(300)


    new BuffDefinition(QIRAJI_COLOSUS_TRAMPLE_BUFF_ID, BuffIds.auraofBlight)
    ..setName("Trample")
    ..setTooltipNormal(1, "Trampled")
    ..setTooltipNormalExtended(1, "This unit is being crushed underfoot.")


    new AbilityDefinitionAuraSlow(QIRAJI_COLOSUS_TRAMPLE_ID)
    ..setName("Trample")
    ..setTooltipNormal(1, "Trample")
    ..setTooltipNormalExtended(1, "The massive size of the colosus causes it to damage surrounding units with every action.")
    ..setMovementSpeedFactor(1, -0.600)
    ..setAreaofEffect(1, TRAMPLE_RADIUS)
    ..setBuffs(1, QIRAJI_COLOSUS_TRAMPLE_BUFF_ID.toRawCode())
    ..setTargetsAllowed(1, "enemies,ground,vulnerable")
    ..setIconNormal(Icons.bTNStampede)


    new AbilityDefinitionPassiveSimple(QIRAJI_COLOSUS_PHASE_ID)
    ..setName("Phase (internal)")
    ..setEditorSuffix("(Colosus passive)")
    ..setHeroAbility(false)
    ..setItemAbility(false)
    ..presetButtonPosNormal(0, 0)
    ..setIconNormal(Icons.bTNStampede)



    new ChannelAbilityPreset(QIRAJI_COLOSUS_CHARGE_ID, 1, true)
      ..setName("Charge")
      ..setHeroAbility(false)
      ..setTooltipNormal(1, "Charge")
      ..setTooltipNormalExtended(1, "Ready for a charge after 3s deal massive damage in a line.")
      ..presetTargetTypes(Targettype.POINT)
      ..setCastRange(1, 1000)
      ..setCooldown(1, 10)
      ..setIconNormal("ReplaceableTextures\\CommandButtons\\BTNCharge.blp")


    new UnitDefinition(QIRAJI_COLOSUS_CHARGE_INDICATOR_ID, 'ewsp') 
        ..setName("Spell Dummy")
        ..setModelFile("Skill_Indicator_Straight.mdx") 
        ..setNormalAbilities(commaList('Aloc', 'Avul')) 
        ..setFoodCost(0)
        ..setCollisionSize(0.0)
        ..setScalingValue(5.)
        ..setAnimationCastBackswing(0.0)
        ..setAnimationCastPoint(0.0)
        ..setManaMaximum(1000)
        ..setManaInitialAmount(1000)


init
    EventListener.onPointCast(QIRAJI_COLOSUS_CHARGE_ID) (unit caster, vec2 target) ->
        let owner = caster.getOwner()
        let pos = caster.getPos()
        
        let angle = pos.angleTo(target)
        let maxChargeDistance = 1000.0
        let finalTargetPos = pos.polarOffset(angle, maxChargeDistance)
        
        let indicatorDummy = createUnit(owner, QIRAJI_COLOSUS_CHARGE_INDICATOR_ID, pos, angle)
        
        var stepDist = 120.0
        while stepDist <= maxChargeDistance
            let fxPos = pos.polarOffset(angle, stepDist)
            flashEffect("Abilities\\Spells\\Orc\\LiquidFire\\LiquidFire.mdl", fxPos)
            stepDist += 120.0
            
        let bossChargeGlow = caster.addEffect("Abilities\\Spells\\Orc\\Bloodlust\\BloodlustTarget.mdl", "origin")
        
        caster.pause()
        caster.setAnimation("channel")
        
        doAfter(3.0) ->
            indicatorDummy.remove()
            bossChargeGlow.destr()
            
            
            if caster.isAlive()
                caster.setAnimation("walk")
                
                let damagedGroup = CreateGroup()
                let chargeSpeed = 1600.0       
                let speedPerTick = chargeSpeed * 0.03
                var traveledDistance = 0.0
                
                
                doPeriodically(0.03) (CallbackPeriodic cb) ->
                    if not caster.isAlive()
                        damagedGroup.destr()
                        destroy cb
                        return
                    
                    let currentPos = caster.getPos()
                    let nextPos = currentPos.polarOffset(angle, speedPerTick)
                    
                    caster.setPos(nextPos)
                    traveledDistance += speedPerTick
                    dustDistanceTracker += speedPerTick
                    
                    if dustDistanceTracker >= 75.0
                        flashEffect("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl", currentPos)
                    
                    forUnitsInRange(nextPos, 300.0) (unit victim) ->
                        if victim.isAlive() and victim.isEnemyOf(owner) and not IsUnitInGroup(victim, damagedGroup) and not victim.isType(UNIT_TYPE_FLYING)
                            GroupAddUnit(damagedGroup, victim)
                            
                            caster.damageTarget(
                                victim, 
                                DAMAGE_AMOUNT, 
                                false, 
                                false, 
                                ATTACK_TYPE_HERO, 
                                DAMAGE_TYPE_NORMAL, 
                                WEAPON_TYPE_WHOKNOWS
                            )
                            flashEffect("Abilities\\Spells\\Other\\HeavySlam\\HeavySlamTarget.mdl", victim.getPos())
                    
                    if traveledDistance >= maxChargeDistance
                        caster.setPos(finalTargetPos) 
                        caster.unpause()             
                        caster.setAnimation("stand")
                        
                        damagedGroup.destr()
                        destroy cb









  
    forUnitsOfType(QIRAJI_COLOSUS_ID.toRawCode()) (unit colosus) ->
        colosus.addAbility(QIRAJI_COLOSUS_PHASE_ID)
        new TrampleTracker(colosus)

    registerPlayerUnitEvent(EVENT_PLAYER_UNIT_TRAIN_FINISH) () ->
        let colosus = GetTrainedUnit()
        if colosus.getTypeId() == QIRAJI_COLOSUS_ID
            colosus.addAbility(QIRAJI_COLOSUS_PHASE_ID)
            new TrampleTracker(colosus)


function damageNearbyEnemies(unit colosus)
    let pos   = colosus.getPos()
    let owner = colosus.getOwner()
    let dmg   = TRAMPLE_DPS * TRAMPLE_INTERVAL

    forUnitsInRange(pos, TRAMPLE_RADIUS) (unit target) ->
        if target != colosus and target.isAlive() and target.isEnemyOf(owner) and not target.isType(UNIT_TYPE_FLYING) and not target.isInvulnerable()
            colosus.damageTarget(
                target,
                dmg,
                false, 
                false, 
                ATTACK_TYPE_NORMAL,
                DAMAGE_TYPE_NORMAL,
                WEAPON_TYPE_WHOKNOWS
            )