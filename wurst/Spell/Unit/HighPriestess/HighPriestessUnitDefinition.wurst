package HighPriestessUnitDefinition

import UnitIds
import Icons
import AbilityObjEditing
import ObjectIds
import ObjectIdGenerator

import GravityFlow
import ElusiveBlessing

public constant HIGH_PRIESTESS_UNIT_ID = compiletime(UNIT_ID_GEN.next())

@compiletime function gen()
  new UnitDefinition(HIGH_PRIESTESS_UNIT_ID, UnitIds.sorceress)
    ..setName("High Priestess")
    ..setTooltipBasic("Train High Priestess")
    ..setTooltipExtended("Versatile spellcaster, can cast Elusive Blessing on allies increasing attack speed and dodge rating, can also cast Gravity Flow damaging enemies and tossing them toward the center of the cast.")
    ..setIconGameInterface("ReplaceableTextures\\CommandButtons\\BTNSinduDZ.blp")
    ..setHotkey("R")
    ..setButtonPositionX(3)
    ..setButtonPositionY(0)
    ..setModelFile("SinduDZ.mdx")
    ..setHitPointsMaximumBase(450)
    ..setAttack1DamageBase(25)
    ..setNormalAbilities(commaList(ABIL_ELUSIVE_BLESSING, ABIL_GRAVITY_FLOW))
    ..setManaMaximum(375)
    ..setAttack1AttackType(AttackType.Magic)
    ..setAttack1WeaponType(WeaponType.Instant)
    ..setGoldCost(70)
    ..setLumberCost(0)
    ..setBuildTime(10)

init
  createUnit(localPlayer, HIGH_PRIESTESS_UNIT_ID, gg_rct_TrollParty.getCenter())