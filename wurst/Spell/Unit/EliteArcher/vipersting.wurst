package vipersting

import ClosureEvents
import OrderIds
import ChannelAbilityPreset
import DummyCaster
import ClosureTimers

import Projectile

public constant VIPER_STING_ID = compiletime(ABIL_ID_GEN.next())

let VIPER_STING_MAX_TOTAL_DAMAGE = 200.0   // NEW: hard cap per cast, shared across every unit the projectile hits
let VIPER_STING_BASE_DAMAGE = 80.0

@compiletime function genViperSting()
    new ChannelAbilityPreset(VIPER_STING_ID,1, true)
        ..setButtonPositionNormalX(2)
        ..setButtonPositionNormalY(0)
        ..setIconNormal(Icons.bTNPoisonArrow)
        ..setTooltipNormal(1, "Viper Sting")
        ..setTooltipNormalExtended(1, "Fires a venom-tipped arrow in a straight line. Enemies struck take physical puncture damage and are infected with a lethal toxin that slows movement speed and inflicts nature damage over time.")
        ..setCooldown(1, 10.0)
        ..setManaCost(1, 60)
        ..setCastRange(1, 1100.0)
        ..setTargetType(1, 2) // Point Target

@compiletime function giveAbilToUnit()
    new UnitDefinition('e00P', 'e00P')
        ..setNormalAbilities(commaList(VIPER_STING_ID))

// NEW: shared mutable budget tracker, one instance created per cast
class DamageBudgetBox
    real remaining = VIPER_STING_MAX_TOTAL_DAMAGE

function applyPoison(unit source, unit target)
    new DummyCaster()
        ..origin(target.getPos())
        ..owner(source.getOwner()) 
        ..delay(1.5)
        ..castTarget(AbilityIds.shadowStrike, 1, OrderIds.shadowstrike, target)

init
    EventListener.onPointCast(VIPER_STING_ID) (caster, targetPos) ->
        let casterPos = caster.getPos()

        let speed = 1400.0
        let radius = 90.0
        let maxRange = 1100.0
        let poisonArrowModel = "Abilities\\Weapons\\PoisonArrow\\PoisonArrowMissile.mdl"

        // NEW: one shared budget for this specific cast, consumed as the projectile hits units
        let budget = new DamageBudgetBox()
        let eff = addEffect("Skill_Indicator_Straight2.mdx", caster.getPos3Real())
        eff.setScale(5.0)
        let ang = caster.getPos().angleTo(targetPos)
        let targetZ = targetPos.getTerrainZ()
        let casterZ = casterPos.getTerrainZ()
        eff.setYaw(ang)
        if targetZ > casterZ
            eff.setZ(targetZ)
        else
            eff.setZ(casterZ)
        caster.pause()
        doAfter(2.0) -> 
            eff.destr()
            caster.unpause()
            

            new PortableProjectile(caster, casterPos, targetPos, speed, radius, maxRange, poisonArrowModel) target ->

                if budget.remaining <= 0.0
                    return   // NEW: cast has already dealt its full 200 damage - no more hits do anything

                // NEW: clamp this hit's damage to whatever budget remains, never exceeding the shared cap
                let thisHitDamage = budget.remaining < VIPER_STING_BASE_DAMAGE ? budget.remaining : VIPER_STING_BASE_DAMAGE
                budget.remaining -= thisHitDamage

                dealDamage(caster, target, thisHitDamage, ATTACK_TYPE_PIERCE, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WOOD_LIGHT_BASH)

                // NEW: only apply the poison DoT if there's still meaningful budget left -
                // otherwise a 5th/6th target hit for near-zero direct damage would still get
                // full poison damage on top, quietly blowing past the cap anyway
                if budget.remaining > 0.0
                    applyPoison(caster, target)