package DryadDispel

import ObjectIds
import ObjectIdGenerator
import AbilityObjEditing
import AbilityIds
import Icons

public constant DRYAD_CASTER_DISPEL = compiletime(ABIL_ID_GEN.next())


@compiletime function genDryadDispel()
  new AbilityDefinitionDispelMagic(DRYAD_CASTER_DISPEL)
    ..setName("Cleansing Pollen")
    ..setTooltipNormal(1, "Cleansing Pollen")
    ..setIconNormal(Icons.bTNDryadDispelMagic)
    ..setIconResearch(Icons.bTNDryadDispelMagic)
    ..setAreaofEffect(1, 200)
    ..setRequirements(commaList('R005')) // Invoke Spirits
    ..setRequirementsLevels("1")
  