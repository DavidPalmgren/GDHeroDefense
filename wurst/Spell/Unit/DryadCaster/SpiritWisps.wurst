package SpiritWisps
import AbilityObjEditing
import ObjectIdGenerator
import BuffObjEditing
import Icons
import ClosureEvents
import ClosureTimers
import LinkedList
import ObjectIds
import UnitIds


public constant SPIRIT_WISPS_ID = compiletime(ABIL_ID_GEN.next())
public constant WISP_BUFF_ID = compiletime(BUFF_ID_GEN.next())

constant int WISP_UNIT_ID = UnitIds.wisp
constant int WISP_COUNT = 3
constant real WISP_DURATION = 10.
constant real WISP_HEAL = 25.
constant real WISP_RADIUS = 500.
constant real HEAL_INTERVAL = 1.
constant real ORBIT_RADIUS = 500.
constant real ORBIT_SPEED = 1.5
constant real UPDATE_INTERVAL = 0.05

@compiletime function genBuff()
    new BuffDefinition(WISP_BUFF_ID, 'Basl')
        ..setName(1, "Spirit Wisps")
        ..setTooltipNormal(1, "Spirit Wisps")
        ..setTooltipNormalExtended(1, "This unit is accompanied by healing spirit wisps.")
        ..setIcon(Icons.bTNWisp)

@compiletime function genAbility()
    new AbilityDefinitionRoar(SPIRIT_WISPS_ID)
        ..setName("Spirit Wisps")
        ..setTooltipNormal(1, "Spirit Wisps")
        ..setTooltipNormalExtended(1, "Summons 3 spirit wisps that orbit the caster for " + WISP_DURATION.toInt().toString() + " seconds, healing nearby damaged friendly units for " + WISP_HEAL.toInt().toString() + " HP/s.")
        ..setTooltipLearn("Learn Spirit Wisps")
        ..setTooltipLearnExtended("Summons 3 spirit wisps that orbit the caster, healing nearby damaged friendly units.")
        ..setIconNormal(Icons.bTNWisp)
        ..setButtonPositionNormalX(2)
        ..setButtonPositionNormalY(0)
        ..setCooldown(1, 20.)
        ..setManaCost(1, 70)
        ..setDamageIncrease(1, 0.)
        ..setAreaofEffect(1, 0.)
        ..setDurationNormal(1, 10.)
        ..setDurationHero(1, 0.)
        ..setBuffs(1, toRawCode(WISP_BUFF_ID))
        ..setRequirements(commaList('R005')) // Invoke Spirits
        ..setRequirementsLevels("2")
        ..setRequiredLevel(1)
        ..setLevelSkipRequirement(2)
        ..setHeroAbility(false)
        ..setItemAbility(false)

init
    EventListener.onCast(SPIRIT_WISPS_ID) (caster) ->
        let wisps = new LinkedList<unit>()

        for i = 0 to WISP_COUNT - 1
            let startAngle = (2. * bj_PI * i.toReal()) / WISP_COUNT.toReal()
            let spawnPos = caster.getPos().polarOffset(angle(startAngle), ORBIT_RADIUS)
            let wisp = createUnit(caster.getOwner(), WISP_UNIT_ID, spawnPos, angle(0.))
            wisp.addAbility('Aloc')
            wisp.setVertexColor(50, 255, 50, 255)
            wisp.setScale(0.5)
            wisps.add(wisp)

        let moveTimer = doPeriodically(UPDATE_INTERVAL) cb ->
            // Allocate once per tick, destroy at end of tick
            let wispTargets = new LinkedList<unit>()
            let casterPos   = caster.getPos()

            // Snapshot nearby units into a local list — never reuse ENUM_GROUP mid-loop
            let nearby = new LinkedList<unit>()
            let g = CreateGroup()
            g.enumUnitsInRange(casterPos, WISP_RADIUS)
            for u from g
                if u.isAlive() and u.getOwner().isAllyOf(caster.getOwner()) and u.getHP() < u.getMaxHP()
                    nearby.add(u)

            for wisp in wisps
                unit nearestInjured = null
                var nearestDist = REAL_MAX

                for u in nearby
                    if not wispTargets.has(u)
                        let dist = wisp.getPos().distanceTo(u.getPos())
                        if dist < nearestDist
                            nearestDist    = dist
                            nearestInjured = u

                if nearestInjured != null
                    wispTargets.add(nearestInjured)

                vec2 targetPos
                if nearestInjured != null
                    targetPos = nearestInjured.getPos().polarOffset(
                        wisp.getPos().angleTo(nearestInjured.getPos()),
                        -50.
                    )
                else
                    let randomAngle = angle(GetRandomReal(0., 2. * bj_PI))
                    let randomDist  = GetRandomReal(50., ORBIT_RADIUS)
                    targetPos = casterPos.polarOffset(randomAngle, randomDist)

                let moveDir   = wisp.getPos().angleTo(targetPos)
                let moveSpeed = 200. * UPDATE_INTERVAL
                let newPos    = wisp.getPos().polarOffset(moveDir, moveSpeed)

                if newPos.distanceTo(casterPos) > WISP_RADIUS
                    wisp.setXY(casterPos.polarOffset(newPos.angleTo(casterPos), -WISP_RADIUS + 20.))
                else
                    wisp.setXY(newPos)

            // Destroy both lists every tick — this was the leak
            destroy wispTargets
            destroy nearby

        let healTimer = doPeriodically(HEAL_INTERVAL) cb ->
            let g = CreateGroup()
            g.enumUnitsInRange(caster.getPos(), WISP_RADIUS)
            for u from g
                if u.isAlive() and u.getOwner().isAllyOf(caster.getOwner()) and u.getHP() < u.getMaxHP()
                    u.addHP(WISP_HEAL)
                    flashEffect("Abilities\\Spells\\Items\\AIhe\\AIheTarget.mdl", u, "origin")

        doAfter(WISP_DURATION) ->
            destroy moveTimer
            destroy healTimer
            for wisp in wisps
                wisp.kill()
            destroy wisps
            UnitRemoveAbility(caster, WISP_BUFF_ID)