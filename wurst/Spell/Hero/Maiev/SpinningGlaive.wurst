package SpinningGlaive

import ClosureTimers
import ClosureForGroups
import DummyCaster
import Orders
import AbilityTooltipGenerator
import ClosureEvents

public constant SPINNING_GLAIVE_ID = compiletime(ABIL_ID_GEN.next())
public constant DUMMY_SLOW_ID      = compiletime(ABIL_ID_GEN.next())

constant int MAX_LEVELS = 4

constant real array DAMAGE_PER_SECOND = [35., 50., 65., 80.]
constant real array MOVEMENT_SLOW = [0.30, 0.35, 0.40, 0.45]
constant int array MANA = [90, 100, 110, 120]
constant real array COOLDOWN = [12.5, 11., 9.5, 8.]

constant real TRAVEL_DISTANCE = 300.
constant real TRAVEL_SPEED = 900.
constant real TICK_INTERVAL = 0.03
constant real ZONE_DURATION = 5.
constant real ZONE_TICK_INTERVAL = 1.
constant real DAMAGE_RADIUS = 225.
constant real SLOW_DURATION = 1.5
constant string GLAIVE_MODEL = "Abilities\\Weapons\\SentinelMissile\\SentinelMissile.mdl"

let tgen = new AbilityTooltipGenerator(
    Targettype.POINT,
    "Hurls a massive, spinning glaive in the targeted direction. Upon arrival, the blade zones out the area, continuously grinding and slowing nearby enemies."
)

@compiletime function genSpinningGlaive()
    let def = new ChannelAbilityPreset(SPINNING_GLAIVE_ID, MAX_LEVELS, true, tgen)
        ..setHeroAbility(true)
        ..setLevels(MAX_LEVELS)
        ..presetButtonPosNormal(0, 2)
        ..presetButtonPosResearch(0, 0)
        ..presetHotkey("Q")
        ..setName("Spinning Glaive")
        ..setIconNormal(Icons.bTNFanOfKnives)
        ..setIconResearch(Icons.bTNFanOfKnives)
        ..setLevelSkipRequirement(2)
        ..presetCastRange(lvl -> 1000.)
        ..presetManaCost(lvl -> MANA[lvl - 1])
        ..presetCooldown(lvl -> COOLDOWN[lvl - 1])
        ..presetOption(Option.VISIBLE, true)
        ..presetTargetTypes(Targettype.POINT)
        ..presetDurationNormal(lvl -> ZONE_DURATION)
        ..presetDurationHero(lvl -> ZONE_DURATION)

    new AbilityDefinitionSlow(DUMMY_SLOW_ID)
        ..setDummyAbility()
        ..setLevels(MAX_LEVELS)
        ..presetMovementSpeedFactor(lvl -> MOVEMENT_SLOW[lvl - 1])
        ..presetAttackSpeedFactor(lvl -> 0.)
        ..presetDurationNormal(lvl -> SLOW_DURATION)
        ..presetDurationHero(lvl -> SLOW_DURATION)

    tgen
        ..addProperty("Levels", lvl -> MAX_LEVELS.toString())
        ..addProperty("Name", lvl -> "Spinning Glaive")
        ..addProperty("Hotkey", lvl -> "Q")
        ..addProperty("Damage per Second", lvl -> DAMAGE_PER_SECOND[lvl - 1].toString(0))
        ..addProperty("Movement Slow", lvl -> (MOVEMENT_SLOW[lvl - 1] * 100.).toString(0) + "%")
        ..addProperty("Duration", lvl -> ZONE_DURATION.toString(0) + "s")
        ..addProperty("Radius", lvl -> DAMAGE_RADIUS.toString(0))
        ..addProperty("Mana", lvl -> MANA[lvl - 1].toString())
        ..addProperty("Cooldown", lvl -> COOLDOWN[lvl - 1].toString(1) + "s")
        ..applyToDef(def)

init
    EventListener.onPointCast(SPINNING_GLAIVE_ID) (caster, targetPos) ->
        let level = caster.getAbilityLevel(SPINNING_GLAIVE_ID)
        let owner = caster.getOwner()
        let startPos = caster.getPos()
        let castAngle = startPos.angleTo(targetPos)
        let endPos = startPos.polarOffset(castAngle, TRAVEL_DISTANCE)
        let glaiveFx = addEffect(GLAIVE_MODEL, startPos)
        let travelDuration = TRAVEL_DISTANCE / TRAVEL_SPEED
        let distancePerTick = TRAVEL_SPEED * TICK_INTERVAL
        let tickDamage = DAMAGE_PER_SECOND[level - 1]
        var currentPos = startPos

        glaiveFx.setScale(3.0)
        glaiveFx.setYaw(castAngle.radians())

        doPeriodicallyTimed(TICK_INTERVAL, travelDuration) travelTimer ->
            currentPos = currentPos.polarOffset(castAngle, distancePerTick)
            glaiveFx.setPos(currentPos)

            if travelTimer.isLast()
                doPeriodicallyTimed(ZONE_TICK_INTERVAL, ZONE_DURATION) zoneTimer ->
                    forUnitsInRange(endPos, DAMAGE_RADIUS) targetUnit ->
                        if targetUnit.isAlive() and targetUnit.isEnemyOf(owner) and not targetUnit.isType(UNIT_TYPE_STRUCTURE) and not targetUnit.isType(UNIT_TYPE_FLYING)
                            caster.damageTarget(targetUnit, tickDamage, false, false, ATTACK_TYPE_MAGIC, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
                            new DummyCaster()
                                ..castTarget(DUMMY_SLOW_ID, level, OrderIds.slow, targetUnit)

                    if zoneTimer.isLast()
                        glaiveFx.destr()
