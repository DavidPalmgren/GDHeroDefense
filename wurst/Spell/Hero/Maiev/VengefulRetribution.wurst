package VengefulRetribution

import AbilityObjEditing
import ObjectIdGenerator
import Icons
import DamageEvent
import HashMap
import UnitIds
import AbilityTooltipGenerator
import ClosureForGroups
import ClosureTimers

public constant VENGEFUL_PASSIVE_ID = compiletime(ABIL_ID_GEN.next())
public constant SPIRIT_UNIT_ID      = compiletime(UNIT_ID_GEN.next())

constant int  MAX_LEVELS = 4
constant real array THRESHOLD = [150., 130., 110., 90.]
constant real SPIRIT_DURATION = 15.0

let tgen = new AbilityTooltipGenerator(
    Targettype.PASSIVE,
    "The Warden channels her pain into pure malice. Every time she takes enough damage, "
    + "a short-lived Vengeful Spirit is spawned to assault nearby enemies.")

@compiletime function gen()
    let aDef = new AbilityDefinitionHardenedSkin(VENGEFUL_PASSIVE_ID)
        ..setHeroAbility(true)
        ..setLevels(MAX_LEVELS)
        ..presetButtonPosNormal(2, 2)
        ..presetButtonPosResearch(2, 0)
        ..presetHotkey("E")
        ..setIconNormal(Icons.bTNWarden2)
        ..setIconResearch(Icons.bTNWarden2)
        ..setName("Vengeful Retribution")
        ..setRequirements("")
        ..setLevelSkipRequirement(2)

    for i = 1 to MAX_LEVELS
        aDef
            ..setChancetoReduceDamage(i, 0.0)
            ..setIgnoredDamage(i, 0)
            ..setMinimumDamage(i, 0)
            ..setIncludeMeleeDamage(i, false)
            ..setIncludeRangedDamage(i, false)

    new UnitDefinition(SPIRIT_UNIT_ID, UnitIds.vengeance)
        ..setName("Vengeful Spirit")
        ..setNormalAbilities("")
        ..setHitPointsMaximumBase(300)
        ..setSpeedBase(330)
        ..setAttack1DamageBase(18)
        ..setAttack1CooldownTime(1.2)

    tgen
        ..addProperty("Name",      lvl -> "Vengeful Retribution")
        ..addProperty("Levels",    lvl -> MAX_LEVELS.toString())
        ..addProperty("Hotkey",    lvl -> "E")
        ..addProperty("Threshold", lvl -> THRESHOLD[lvl - 1].toString(0) + " damage")
        ..addProperty("Duration",  lvl -> SPIRIT_DURATION.toString(0) + "s per spirit")
        ..applyToDef(aDef)

let damageRegistry = new HashMap<unit, real>()

init
    DamageEvent.addListener() ->
        let target = DamageEvent.getTarget()

        if target.hasAbility(VENGEFUL_PASSIVE_ID) and target.isAlive()
            let lvl       = target.getAbilityLevel(VENGEFUL_PASSIVE_ID)
            let threshold = THRESHOLD[lvl - 1]

            var currentDmg = damageRegistry.has(target) ? damageRegistry.get(target) : 0.0
            currentDmg += DamageEvent.getAmount()

            while currentDmg >= threshold
                currentDmg -= threshold

                let spawnPos = target.getPos()
                let owner    = target.getOwner()
                let spirit   = createUnit(owner, SPIRIT_UNIT_ID, spawnPos, target.getFacingAngle())

                spirit.setTimedLife(SPIRIT_DURATION)
                flashEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl", spawnPos)

                // Order spirit to attack nearest enemy
                let s = spirit
                forUnitsInRange(spawnPos, 900.) (unit u) ->
                    if u.isAlive()
                        and u.getOwner().isEnemyOf(owner)
                        and not u.isType(UNIT_TYPE_STRUCTURE)
                        s.issueTargetOrder("attack", u)

            damageRegistry.put(target, currentDmg)