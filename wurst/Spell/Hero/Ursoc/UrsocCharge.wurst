package UrsocCharge

import ClosureEvents
import InstantDummyCaster
import Orders
import BuffObjEditing


import AbilityTooltipGenerator

public constant URSOC_CHARGE_ID    = compiletime(ABIL_ID_GEN.next())
public constant CHARGE_STUN_ID     = compiletime(ABIL_ID_GEN.next())
public constant CHARGE_STUN_BUFF_ID = compiletime(BUFF_ID_GEN.next())


constant int MAX_LEVELS = 4

constant real array CHARGE_DAMAGE = [100., 175., 250., 350.]
constant real array STUN_DURATION = [2., 3., 4., 5.]
constant real array HERO_STUN     = [1., 1.5, 2., 2.5]
constant real array CAST_RANGE    = [700., 800., 900., 1000.]
constant real array COOLDOWN      = [12., 10., 8., 6.]
constant int  array MANA          = [60, 70, 80, 90]

constant real   CHARGE_SPEED  = 900.
constant string CHARGE_SFX    = "Abilities\\Spells\\Human\\Charge\\ChargeTarget.mdl"
constant string IMPACT_SFX    = "Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl"
constant string CHARGE_CUSTOM_ICON   = "ReplaceableTextures\\CommandButtons\\BTNCharge.blp"
constant string DISABLED_CUSTOM_ICON = "ReplaceableTextures\\CommandButtonsDisabled\\DISBTNCharge.blp"

let tgen = new AbilityTooltipGenerator(
    Targettype.UNIT,
    "Ursoc charges at the target enemy, dealing damage and stunning them on impact. "
    + "Stun duration is halved on heroes.")

@compiletime function genBuff()
    new BuffDefinition(CHARGE_STUN_BUFF_ID, 'BNso')
        ..setName(1, "Mauled")
        ..setTooltipNormal(1, "Mauled")
        ..setTooltipNormalExtended(1, "This unit has been charged by Ursoc and is stunned.")
        ..setIcon(Icons.bTNStun)

@compiletime function genAbility()
    let aDef = new AbilityDefinitionMountainKingThunderBolt(URSOC_CHARGE_ID)
        ..setHeroAbility(true)
        ..setItemAbility(false)
        ..setIconNormal(CHARGE_CUSTOM_ICON)
        ..setIconResearch(CHARGE_CUSTOM_ICON)
        ..setIconTurnOff(DISABLED_CUSTOM_ICON)
        ..setButtonPositionNormalX(0)
        ..setButtonPositionNormalY(0)
        ..setRequirements("")
        ..setRequirementsLevels("")
        ..setRequiredLevel(1)
        ..setLevelSkipRequirement(2)
        ..setLevels(MAX_LEVELS)

    for i = 1 to MAX_LEVELS
        aDef
            ..setCooldown(i, COOLDOWN[i - 1])
            ..setManaCost(i, MANA[i - 1])
            ..setDamage(i, CHARGE_DAMAGE[i - 1])
            ..setDurationNormal(i, STUN_DURATION[i - 1])
            ..setDurationHero(i, HERO_STUN[i - 1])
            ..setCastRange(i, CAST_RANGE[i - 1])
            ..setBuffs(i, toRawCode(CHARGE_STUN_BUFF_ID))

    tgen
        ..addProperty("Name",       lvl -> "Mauling Charge")
        ..addProperty("Levels",     lvl -> MAX_LEVELS.toString())
        ..addProperty("Hotkey",     lvl -> "Q")
        ..addProperty("Damage",     lvl -> CHARGE_DAMAGE[lvl - 1].toString(0))
        ..addProperty("Stun",       lvl -> STUN_DURATION[lvl - 1].toString(0) + "s (" + HERO_STUN[lvl - 1].toString(1) + "s vs heroes)")
        ..addProperty("Range",      lvl -> CAST_RANGE[lvl - 1].toString(0))
        ..addProperty("Cooldown",   lvl -> COOLDOWN[lvl - 1].toString(0) + "s")
        ..addProperty("Mana",       lvl -> MANA[lvl - 1].toString())
        ..applyToDef(aDef)

init
    EventListener.onCast(URSOC_CHARGE_ID) (caster) ->
        let target    = EventData.getSpellTargetUnit()
        let targetPos = target.getPos()
        let level     = caster.getAbilityLevel(URSOC_CHARGE_ID)

        caster.setXY(targetPos)
        flashEffect(CHARGE_SFX, targetPos)
        flashEffect(IMPACT_SFX, targetPos)

        caster.damageTarget(
            target,
            CHARGE_DAMAGE[level - 1],
            false,
            false,
            ATTACK_TYPE_NORMAL,
            DAMAGE_TYPE_MAGIC,
            WEAPON_TYPE_WHOKNOWS
        )

        InstantDummyCaster.castTarget(caster.getOwner(), CHARGE_STUN_ID, 1, Orders.thunderbolt, target)