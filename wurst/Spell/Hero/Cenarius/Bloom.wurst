package Bloom

import AbilityObjEditing
import Icons
import ObjectIdGenerator
import ClosureEvents
import ClosureTimers
import Abilities
import AbilityTooltipGenerator
import Invigorate

// Initialize Tooltip Generator
let tgen = new AbilityTooltipGenerator(Targettype.NONE, "Spawns a healing cloud on each invigorated unit, healing nearby friendly units. Multiple healing instances stack.")

public constant HEALING_CLOUD_ID = compiletime(ABIL_ID_GEN.next())

constant int CLOUD_UNIT_ID = 'efon'
constant real HEAL_INTERVAL = 1.

@compiletime function genAbility()
    // Configure Properties for tgen

    let def = new ChannelAbilityPreset(HEALING_CLOUD_ID, 4, true, tgen)
        ..setName("Bloom")
        ..setHeroAbility(true)
        ..setLevels(4)
        ..setIconNormal(Icons.bTNHealingWave)
        ..setIconResearch(Icons.bTNHealingWave)
        ..setButtonPositionNormalX(3)
        ..setButtonPositionNormalY(2)
        ..setHotkeyNormal("W")
        
        // Presets
        ..presetCooldown(lvl -> 30.0 - (lvl * 5.0))
        ..presetManaCost(lvl -> 100 + (lvl * 15))

        ..setAreaofEffect(1, 0.)
        ..setDurationNormal(1, 0.)
        ..setDurationHero(1, 0.)
        ..setBuffs(1, "")
        ..setRequirements("")
        ..setRequiredLevel(1)


    tgen.addProperty("Name",       lvl -> "Bloom")
    tgen.addProperty("Healing per second", lvl -> (15.0 + (lvl * 5.0)).toInt().toString())
    tgen.addProperty("Area of Effect", lvl -> (250 + (lvl * 50)).toString())
    tgen.addProperty("Duration", lvl -> (lvl * 10.0).toString())
    tgen.applyToDef(def)

function spawnCloud(player owner, vec2 pos, real heal, real radius, real duration)
    let cloud = createUnit(owner, CLOUD_UNIT_ID, pos, 0 .asAngleDegrees())
    cloud.setInvulnerable(true)
    cloud.addAbility('Aloc') // Locust
    cloud.setPathing(false)
    cloud.setAnimation("stand 4")
    cloud.pause()

    let sfx = cloud.addEffect(Abilities.tranquility, "origin")
    sfx.setColor(0, 255, 0)

    let healTimer = doPeriodically(HEAL_INTERVAL) cb ->
        // Create a local group to avoid global leaks
        let g = CreateGroup()
        g.enumUnitsInRange(pos, radius)
        for u in g
            if u.isAlive() and u.getOwner().isAllyOf(owner)
                u.addHP(heal)
                flashEffect("Abilities\\Spells\\Items\\AIhe\\AIheTarget.mdl", u, "origin")
        g.destr()

    doAfter(duration) ->
        destroy healTimer
        cloud.kill()
        sfx.destr()

init
    EventListener.onCast(HEALING_CLOUD_ID) (unit caster) ->
        let level = caster.getAbilityLevel(HEALING_CLOUD_ID)
        // Ensure index is within bounds (1-based level)
        let heal = 15.0 + (level * 5.0)
        let radius = 250.0 + (level * 50.0)
        let duration = level * 10.0
        
        let g = CreateGroup()
        g.enumUnitsInRange(caster.getPos(), 1500)
        for u in g
            if u.hasAbility(INVIGORATE_BUFF_ID)
                spawnCloud(caster.getOwner(), u.getPos(), heal, radius, duration)
        g.destr()