package SeedBurst

import ClosureEvents
import ClosureForGroups
import AbilityTooltipGenerator
import Invigorate

public constant SEED_BURST_ID = compiletime(ABIL_ID_GEN.next())

constant int MAX_LEVELS = 4

constant real array BURST_DAMAGE = [75., 110., 150., 200.]
constant real array BURST_RADIUS = [256., 300., 350., 400.]
constant real array COOLDOWN = [12., 10., 8., 6.]
constant int array MANA = [65, 80, 95, 110]

constant string BURST_SFX = "NatureBlast.mdx"
constant string EXPLOSION_SFX = "NatureBlast.mdx"

let tgen = new AbilityTooltipGenerator(
    Targettype.NONE,
    "Consumes Invigorate from all affected units, detonating each seed for area damage.")

@compiletime function genAbility()
    let def = new ChannelAbilityPreset(SEED_BURST_ID, MAX_LEVELS, true, tgen)
        ..setName("Seed Burst")
        ..setTooltipLearn("Learn Seed Burst - [|cffffcc00Level %d|r]")
        ..setTooltipLearnExtended("Consumes Invigorate from all affected units, detonating each one for area damage. Damage and radius increase per level.")
        ..setIconNormal(Icons.bTNEntanglingRoots)
        ..setIconResearch(Icons.bTNEntanglingRoots)
        ..presetButtonPosNormal(0, 1)
        ..presetButtonPosResearch(0, 0)
        ..presetTargetTypes(Targettype.NONE)
        ..tooltipStartListen()
        ..presetHotkey("E")
        ..presetCooldown(lvl -> COOLDOWN[lvl - 1])
        ..presetManaCost(lvl -> MANA[lvl - 1])
        ..presetAreaofEffect(lvl -> BURST_RADIUS[lvl - 1])
        ..presetDurationNormal(lvl -> 0.)
        ..presetDurationHero(lvl -> 0.)
        ..setRequirements("")
        ..setRequirementsLevels("")
        ..setRequiredLevel(1)
        ..setLevelSkipRequirement(2)
        ..setHeroAbility(true)
        ..setItemAbility(false)

    for i = 1 to MAX_LEVELS
        def.setBuffs(i, "")

    tgen
        ..addProperty("Name", lvl -> "Seed Burst")
        ..addProperty("Levels", lvl -> MAX_LEVELS.toString())
        ..addProperty("Hotkey", lvl -> "E")
        ..addProperty("Damage", lvl -> BURST_DAMAGE[lvl - 1].toString(0))
        ..addProperty("Area of Effect", lvl -> BURST_RADIUS[lvl - 1].toString(0))
        ..addProperty("Cooldown", lvl -> COOLDOWN[lvl - 1].toString(0) + "s")
        ..addProperty("Mana", lvl -> MANA[lvl - 1].toString())
        ..applyToDef(def)

function detonateSeed(unit caster, player owner, vec2 explodePos, real damage, real radius)
    flashEffect(BURST_SFX, explodePos)
    flashEffect(EXPLOSION_SFX, explodePos)

    forUnitsInRange(explodePos, radius) (unit target) ->
        if target.isAlive()
            and target.getOwner().isEnemyOf(owner)
            and not target.isType(UNIT_TYPE_STRUCTURE)
            caster.damageTarget(target, damage, false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)

init
    EventListener.onCast(SEED_BURST_ID) (caster) ->
        let level = caster.getAbilityLevel(SEED_BURST_ID) - 1
        let owner = caster.getOwner()
        let damage = BURST_DAMAGE[level]
        let radius = BURST_RADIUS[level]

        forUnitsInRect(bj_mapInitialPlayableArea) (unit u) ->
            if u.hasAbility(INVIGORATE_BUFF_ID)
                detonateSeed(caster, owner, u.getPos(), damage, radius)
                u.removeAbility(INVIGORATE_BUFF_ID)
