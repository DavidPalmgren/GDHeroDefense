package CentaurHeroDefinition

import UnitObjEditing
import ObjectIds
import AbilityIds
import ItemIds
import Item
import ItemObjEditing

import CentaurCharge
import CentaurID

@compiletime function gen()
  new UnitDefinition(CENTAUR_HERO_ID, 'ncnk')
    ..setName("Plight of the Plaines")
    ..setSpeedBase(310)
    ..setAttack1DamageBase(30)

    ..setAttack1AttackType(AttackType.Chaos)
    ..setHitPointsMaximumBase(1700)
    ..setHitPointsRegenerationRate(5)
    ..setSleeps(false)
    ..setCollisionSize(16)

    ..setNormalAbilities(commaList(CENTAUR_CHARGE_ID, AbilityIds.commandAura, AbilityIds.thornyShieldDragonTurtle, AbilityIds.inventory))
  
  new UnitDefinition(CENTAUR_MELEE_ID, 'ncen')
    ..setSleeps(false)
    ..setSpeedBase(310)
    ..setCollisionSize(8)


  new UnitDefinition(CENTAUR_RANGED_ID, 'ncim')
    ..setSleeps(false)
    ..setSpeedBase(310)
    ..setCollisionSize(8)

