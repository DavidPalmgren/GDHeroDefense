package GromAI


import ClosureTimers
import ClosureForGroups

import HeroicLeap
import Berserk
import AxeToss

public var axeTossAICooldown = 0.0
public var leapAICooldown = 0.0
public var berserkAICooldown = 0.0 

// FIXED: Moving targetHero to package scope allows the closure to update it perfectly!
public unit targetHero = null

public constant AI_MAX_LEAP_RANGE = 700.0

/// Call this function right after spawning your Grom boss to set his stats and AI
public function initializeGromAI(unit boss, int bossLevel)
    SetHeroLevel(boss, bossLevel, false)
    boss.addAbility(BERSERK_ID)
    boss.addAbility(AXE_TOSS_ID)

    let skillLevelsToLearn = bossLevel.clamp(1, 3)
    for i = 1 to skillLevelsToLearn
        SelectHeroSkill(boss, HEROIC_LEAP_ID)
        
    print("Grom AI Active. Spells trained successfully.")
        
    doPeriodically(1.0) (CallbackPeriodic cb) ->
        if not boss.isAlive()
            destroy cb 
        else
            if leapAICooldown > 0
                leapAICooldown -= 1.0
            if berserkAICooldown > 0
                berserkAICooldown -= 1.0
            if axeTossAICooldown > 0
                axeTossAICooldown -= 1.0
                
            executeBossLogic(boss)

function executeBossLogic(unit boss)
    // Clear out the tracking handle right before starting our fresh radar scan
    targetHero = null 
    
    forUnitsInRange(boss.getPos(), 900.0) (unit u) ->
        if u.isType(UNIT_TYPE_HERO) and u.isAlive() and u.isEnemyOf(boss.getOwner())
            targetHero = u

    // If the scanner didn't lock onto an enemy hero, exit early
    if targetHero == null
        return

    // 1. BERSERK OFF COOLDOWN LOGIC
    if berserkAICooldown <= 0.0
        print("AI: Attempting to activate Berserk...")
        if boss.issueImmediateOrder("berserk")
            print("BERSERK CAST SUCCESSFUL!")
            berserkAICooldown = 15.0
        else
            print("BERSERK ORDER FAILED!")

    // 2. HEROIC LEAP LOGIC
    if leapAICooldown <= 0.0
        let distance = boss.getPos().distanceTo(targetHero.getPos())
        
        if distance <= AI_MAX_LEAP_RANGE
            print("AI: Targeted " + targetHero.getName() + " at distance: " + distance.toString())
            leapAICooldown = 14.0 
            
            if boss.issuePointOrder("shockwave", targetHero.getPos())
                print("LEAP CAST SUCCESSFUL!")
            else
                print("LEAP ORDER REJECTED BY ENGINE!")

      // 3. AXE TOSS OFF COOLDOWN LOGIC
    if axeTossAICooldown <= 0.0
        print("AI: Hurling axe at " + targetHero.getName())
        
        // "stormbolt" is the internal engine order string for our base ability
        if boss.issueTargetOrder("stormbolt", targetHero)
            axeTossAICooldown = 5.0