package DevHacks

import RegisterEvents
import ClosureTimers
import Player

// ============================================================================
// SECURITY TOGGLE: Set to false before compiling the public release!
// ============================================================================

player targetPlayer = null
var currentColorIdx = 0

init
    if localPlayer == players[0]
        CreateFogModifierRect(players[0], FOG_OF_WAR_VISIBLE, bj_mapInitialPlayableArea, true, false).start()
        players[0].setGold(10000)
        players[0].setLumber(10000)

    let t = CreateTrigger()
    
    for i = 0 to bj_MAX_PLAYER_SLOTS - 1
        TriggerRegisterPlayerChatEvent(t, players[i], "-", false)
    
    t.addAction() ->
        let chatString = GetEventPlayerChatString()
        let p = GetTriggerPlayer()

        if p == localPlayer
            if chatString.startsWith("-lvl")
                let levelRequested = chatString.substring(5).toInt()
                let hero = p.getCursorFocus()
                
                if hero != null
                    hero.setLevel(levelRequested, true)
                    printTimedToPlayer("Level set to " + levelRequested.toString(), 5.0, p)
                else
                    printTimedToPlayer("Select a hero first!", 5.0, p)