package ZandalariUpgradeCenter

import UnitObjEditing
import ObjectIdGenerator

import ObjectIds
import ZandalariBaseUpgrades

public constant ZANDALARI_UPGRADE_CENTER_ID = compiletime(UNIT_ID_GEN.next())

// https://www.hiveworkshop.com/bundles/wciitrolllumbermill.48407/download?token=be620c447c96ac32bddaf0c8f0c665b2_48407_1781550636

@compiletime function genZandalariUpgradeCenter()
    new BuildingDefinition(ZANDALARI_UPGRADE_CENTER_ID, 'ofor') // Natively inherits Orc War Mill properties
        ..setName("Mojo Crucible")
        ..setTooltipBasic("Build Mojo Crucible")
        ..setTooltipExtended("The technological and spiritual forge of the empire. Refines tribal alloys and extracts potent mojo to upgrade your forces.")
        ..setIconGameInterface("ReplaceableTextures\\CommandButtons\\BTNTrollHut.blp") // cant find icon lets move on
        ..setModelFile("WCIITrollLumberMill.mdx")
        
        ..setResearchesAvailable("")

        ..setGoldCost(50)
        ..setLumberCost(0)

        ..setBuildTime(30)
        ..setHitPointsMaximumBase(1000)
        // Upgrades
        ..setResearchesAvailable(commaList(ZANDALARI_DAMAGE_UPG_ID, ZANDALARI_ARMOR_UPG_ID))