package ZandalariLoaShrines

import UnitObjEditing
import ObjectIdGenerator
import ObjectIds
import Icons
import UnitIds

import ZandalariLoaShrinesUpgrades
import ZandalariTownHallID
import RegisterEvents

// --- ENGINE GENERATED ENGINE KEYS ---
public constant ZANDALARI_MONUMENT_ID         = compiletime(UNIT_ID_GEN.next())
public constant ZANDALARI_ALTAR_REZAN_ID       = compiletime(UNIT_ID_GEN.next())
public constant ZANDALARI_ALTAR_BWONSAMDI_ID   = compiletime(UNIT_ID_GEN.next())
public constant ZANDALARI_ALTAR_GONK_ID        = compiletime(UNIT_ID_GEN.next())

// --- DUMMY CONFIGURATION KEYS ---
constant REZAN_UNIT_ID     = 'u001' 
constant REZAN_TECH_ID     = 'R001' 
constant BWONSAMDI_UNIT_ID = 'u002' 
constant BWONSAMDI_TECH_ID = 'R002' 
constant GONK_UNIT_ID      = 'u003' 
constant GONK_TECH_ID      = 'R003' 

constant REZAN_GHOST_ID = 'ndtr' // dark troll for now

@compiletime function genZandalariLoaSystem()

    // =========================================================================
    // BASE BUILDING: ZANDALARI MONUMENT
    // =========================================================================
    new BuildingDefinition(ZANDALARI_MONUMENT_ID, 'hwtw')
        ..setName("Zandalari Monument")
        ..setTooltipBasic("Build [|cffffcc00Zandalari Monument|r]")
        ..setTooltipExtended("A stone foundation erected in honor of the wild gods. Can be upgraded and dedicated to a specific Loa to unlock divine units and forbidden tech pathways.")
        ..setIconGameInterface(Icons.bTNVoodooLounge)
        ..setModelFile("Doodads\\Ruins\\Props\\Ruins_NagaCircle\\Ruins_NagaCircle.mdl")
        ..setGoldCost(80)
        ..setLumberCost(0) 
        ..setBuildTime(30)
        ..setHitPointsMaximumBase(600)
        ..setArmorType(ArmorType.Fortified)
        ..setDefenseBase(2)
        ..setRequirements(commaList(ZANDALARI_T3_ID))
        ..setResearchesAvailable("")
        ..setNormalAbilities("")
        ..setUpgradesTo(commaList(
            ZANDALARI_ALTAR_REZAN_ID, 
            ZANDALARI_ALTAR_BWONSAMDI_ID, 
            ZANDALARI_ALTAR_GONK_ID
        ))

    // =========================================================================
    // PATH 1: ALTAR OF REZAN
    // =========================================================================
    new BuildingDefinition(ZANDALARI_ALTAR_REZAN_ID, 'hwtw')
        ..setName("Altar of Rezan")
        ..setTooltipBasic("Dedicate to [|cffffcc00Rezan|r]")
        ..setTooltipExtended("Infuse the monument with the blinding golden light of the Devilsaur Loa. Unlocks high-impact holy melee forces and raw physical combat techniques.")
        ..setIconGameInterface(Icons.bTNAttack) 
        ..setModelFile("Doodads\\Ruins\\Props\\Ruins_NagaCircle\\Ruins_NagaCircle.mdl")
        ..setButtonPositionX(0) 
        ..setButtonPositionY(0) 
        ..setUnitsTrained(commaList(REZAN_UNIT_ID))
        ..setResearchesAvailable(commaList(UPG_REZAN_GOLDEN_TRIBUTE))
        ..setGoldCost(150)
        ..setLumberCost(0) 
        ..setBuildTime(45)
        ..setHitPointsMaximumBase(1100) 
        ..setDefenseBase(5)
        ..setRequirements(commaList(""))
        ..setUpgradesTo("")
        ..setNormalAbilities("")

    // =========================================================================
    // PATH 2: ALTAR OF BWONSAMDI
    // =========================================================================
    new BuildingDefinition(ZANDALARI_ALTAR_BWONSAMDI_ID, 'hwtw')
        ..setName("Altar of Bwonsamdi")
        ..setTooltipBasic("Dedicate to [|cffffcc00Bwonsamdi|r]")
        ..setTooltipExtended("Shroud the stone foundation in the dark, spectral mists of the Loa of Graves. Unlocks soul-manipulating ritualists and shadow manipulation technologies.")
        ..setIconGameInterface(Icons.bTNAnimateDead) 
        ..setButtonPositionX(1) 
        ..setButtonPositionY(0) 
        ..setUnitsTrained(commaList(BWONSAMDI_UNIT_ID))
        ..setResearchesAvailable(commaList(BWONSAMDI_TECH_ID))
        ..setGoldCost(150)
        ..setLumberCost(0) 
        ..setBuildTime(45)
        ..setHitPointsMaximumBase(1100)
        ..setDefenseBase(5)
        ..setRequirements(commaList(""))
        ..setUpgradesTo("")
        ..setNormalAbilities("")

    // =========================================================================
    // PATH 3: ALTAR OF GONK
    // =========================================================================
    new BuildingDefinition(ZANDALARI_ALTAR_GONK_ID, 'hwtw')
        ..setName("Altar of Gonk")
        ..setTooltipBasic("Dedicate to [|cffffcc00Gonk|r]")
        ..setTooltipExtended("Attune the monolith to the echo of the Great Raptor. Unlocks versatile shape-shifting primal forces and army-wide movement velocity research nodes.")
        ..setIconGameInterface(Icons.bTNNatureTouchGrow) 
        ..setButtonPositionX(2) 
        ..setButtonPositionY(0) 
        ..setUnitsTrained(commaList(GONK_UNIT_ID))
        ..setResearchesAvailable(commaList(GONK_TECH_ID))
        ..setGoldCost(150)
        ..setLumberCost(0) 
        ..setBuildTime(45)
        ..setHitPointsMaximumBase(1100)
        ..setDefenseBase(5)
        ..setRequirements(commaList(""))
        ..setUpgradesTo("")
        ..setNormalAbilities("")

init
    registerPlayerUnitEvent(EVENT_PLAYER_UNIT_CONSTRUCT_FINISH) ->
        let finishedBuilding = GetTriggerUnit()
        if finishedBuilding.getTypeId() == ZANDALARI_ALTAR_REZAN_ID
            onRezanAltarCompleted(finishedBuilding)

    registerPlayerUnitEvent(EVENT_PLAYER_UNIT_UPGRADE_FINISH) ->
        let upgradedBuilding = GetTriggerUnit()
        if upgradedBuilding.getTypeId() == ZANDALARI_ALTAR_REZAN_ID
            onRezanAltarCompleted(upgradedBuilding)


function onRezanAltarCompleted(unit altar)
    let x = altar.getX()
    let y = altar.getY()
    
    AddSpecialEffect("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdx", x, y)
        ..destr() 
    
    let ghostUnit = CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), REZAN_GHOST_ID, x, y, 270.0)
    
    ghostUnit.setVertexColor(255, 255, 255, 120)

    ghostUnit.setInvulnerable(true)

    SetUnitPathing(ghostUnit, false)
    ghostUnit.setPos(x,y)