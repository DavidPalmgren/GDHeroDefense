package BloodPact

import ObjectIdGenerator
import AbilityObjEditing
import RegisterEvents
import ClosureTimers
import ClosureForGroups
import ChannelAbilityPreset
import HashMap
import AbilityTooltipGenerator

public constant BLOOD_PACT = compiletime(ABIL_ID_GEN.next())

constant int    MAX_LEVELS      = 3
constant real   IMMUNE_DURATION = 5.0
constant real   MIN_HP_LEFT     = 1.0
constant real   AOE_RADIUS      = 400.0

constant real array DAMAGE_FACTOR = [1.0, 1.25, 1.5]
constant int  array MANA_COST     = [150, 175, 200]
constant real array COOLDOWN      = [120.0, 100.0, 80.0]
constant real array CAST_RANGE    = [600.0, 650.0, 700.0]

let tgen = new AbilityTooltipGenerator(
    Targettype.POINT,
    "Vol'jin sacrifices his current HP, dealing a portion of it as damage to all enemies in the target area. "
    + "Vol'jin becomes immune to death for " + IMMUNE_DURATION.toString(0) + "s after the sacrifice.")

@compiletime function gen()
    let def = new ChannelAbilityPreset(BLOOD_PACT, MAX_LEVELS, true, tgen)
        ..setHeroAbility(true)
        ..setIconNormal("ReplaceableTextures\\CommandButtons\\BTNBTNpowerofblood.blp")
        ..setIconResearch("ReplaceableTextures\\CommandButtons\\BTNBTNpowerofblood.blp")
        ..setButtonPositionNormalX(3)
        ..setButtonPositionNormalY(2)
        ..setTargetType(1, 2)
        ..setRequiredLevel(6)
        ..setLevelSkipRequirement(5)
        ..presetOption(Option.TARGETIMAGE, true)
        ..tooltipStartListen()
        ..presetHotkey("R")
        ..setName("Blood Pact")
        ..presetAreaofEffect(lvl -> AOE_RADIUS)
        ..presetManaCost(lvl -> MANA_COST[lvl - 1])
        ..presetCooldown(lvl -> COOLDOWN[lvl - 1])
        ..presetCastRange(lvl -> CAST_RANGE[lvl - 1])

    for i = 1 to MAX_LEVELS
        def
            ..setDurationNormal(i, 0.1)
            ..setDurationHero(i, 0.1)
            ..setDisableOtherAbilities(i, false)

    tgen
        ..addProperty("Damage",          lvl -> (DAMAGE_FACTOR[lvl - 1] * 100).toString(0) + "% of sacrificed HP")
        ..addProperty("Death Immunity",  lvl -> IMMUNE_DURATION.toString(0) + "s")
        ..addProperty("Cooldown",        lvl -> COOLDOWN[lvl - 1].toString(0) + "s")
        ..addProperty("Cast Range",      lvl -> CAST_RANGE[lvl - 1].toString(0))
        ..applyToDef(def)


// Tracks units currently immune to death from Blood Pact
let immuneUnits = new HashMap<unit, bool>()

function applyDeathImmunity(unit hero)
    immuneUnits.put(hero, true)
    hero.setInvulnerable(true)
    flashEffect("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl", hero, "origin")

    doAfter(IMMUNE_DURATION) ->
        if hero.isAlive()
            hero.setInvulnerable(false)
        immuneUnits.remove(hero)
        flashEffect("Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl", hero, "origin")

function executeBloodPact(unit hero, vec2 targetPos, int level)
    let idx         = (level - 1).clamp(0, MAX_LEVELS - 1)
    let factor      = DAMAGE_FACTOR[idx]
    let currentHP   = hero.getHP()
    // How much HP we sacrifice — everything above MIN_HP_LEFT
    let sacrificed  = currentHP - MIN_HP_LEFT

    if sacrificed <= 0.0
        return

    // Reduce hero HP to minimum
    hero.setHP(MIN_HP_LEFT)

    // Flash effect at target
    flashEffect("Abilities\\Spells\\Human\\Feedback\\ArcaneTowerAttack.mdl", targetPos)
    flashEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl", targetPos)

    // Deal damage to all enemies in AOE
    let damage = sacrificed * factor
    forUnitsInRange(targetPos, AOE_RADIUS) (unit target) ->
        if target.isAlive()
            and target != hero
            and target.getOwner().isEnemyOf(hero.getOwner())
            and not target.isType(UNIT_TYPE_STRUCTURE)
            hero.damageTarget(
                target,
                damage,
                false,
                false,
                ATTACK_TYPE_HERO,
                DAMAGE_TYPE_MAGIC,
                WEAPON_TYPE_WHOKNOWS
            )
            flashEffect("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl", target, "origin")

    // Apply death immunity
    applyDeathImmunity(hero)

    printTimed("|cffff0000[Blood Pact]|r Vol'jin sacrificed "
        + sacrificed.toString(0) + " HP dealing "
        + damage.toString(0) + " damage!", 5.)

init
    registerPlayerUnitEvent(EVENT_PLAYER_UNIT_SPELL_EFFECT) ->
        if GetSpellAbilityId() == BLOOD_PACT
            let caster     = GetTriggerUnit()
            let targetPos  = vec2(GetSpellTargetX(), GetSpellTargetY())
            let level      = caster.getAbilityLevel(BLOOD_PACT)
            executeBloodPact(caster, targetPos, level)