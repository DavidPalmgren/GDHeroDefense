package BerserkersFury

import RegisterEvents
import ClosureTimers
import HashMap
import LinkedList

import AbilityTooltipGenerator

public constant BERSERKERS_FURY = compiletime(ABIL_ID_GEN.next())

constant int  MAX_LEVELS          = 4
constant real MAX_BONUS_THRESHOLD = 0.90

function getMaxAttackSpeed(int idx) returns real
    switch idx
        case 0
            return 0.40
        case 1
            return 0.80
        case 2
            return 1.20
        case 3
            return 1.40
        default
            return 0.0

function getMaxHpRegen(int idx) returns real
    switch idx
        case 0
            return 4.0
        case 1
            return 7.0
        case 2
            return 11.0
        case 3
            return 16.0
        default
            return 0.0

function getMaxHealAmp(int idx) returns real
    switch idx
        case 0
            return 0.30
        case 1
            return 0.60
        case 2
            return 0.90
        case 3
            return 1.20
        default
            return 0.0

let passiveUsers   = new LinkedList<unit>()
let lastRegenBonus = new HashMap<unit, real>()
let baseCooldown   = new HashMap<unit, real>()
let debugThrottler = new HashMap<unit, int>()

let tgen = new AbilityTooltipGenerator(
    Targettype.PASSIVE,
    "The hero's blood boils as they take damage, growing stronger the closer they are to death. "
    + "Max power reached at 10% HP.")

@compiletime function gen()
    let def = new AbilityDefinitionPaladinDevotionAura(BERSERKERS_FURY)
        ..setHeroAbility(true)
        ..setLevels(MAX_LEVELS)
        ..setName("Berserker's Fury")
        ..setIconNormal(Icons.bTNBerserkForTrolls)
        ..setIconResearch(Icons.bTNBerserkForTrolls)
        ..setTargetsAllowed(1, "self")
        ..setBuffs(1, "")

    for i = 1 to MAX_LEVELS
        def
            ..setArmorBonus(i, 0.0)
            ..setAreaofEffect(i, 10.0)

    tgen
        ..addProperty("Name",               lvl -> "Berserker's Fury")
        ..addProperty("Levels",             lvl -> MAX_LEVELS.toString())
        ..addProperty("Hotkey",             lvl -> "E")
        ..addProperty("HP Regen",           lvl -> "+" + getMaxHpRegen(lvl - 1).toString(0) + " HP/s")
        ..addProperty("Attack Speed",       lvl -> "+" + (getMaxAttackSpeed(lvl - 1) * 100).toString(0) + "%")
        ..addProperty("Heal Amplification", lvl -> "+" + (getMaxHealAmp(lvl - 1) * 100).toString(0) + "%")
        ..applyToDef(def)

public function unit.getHealingMultiplier() returns real
    let lvl = this.getAbilityLevel(BERSERKERS_FURY)
    if lvl <= 0 or not this.isAlive()
        return 1.0

    let idx = (lvl - 1).clamp(0, MAX_LEVELS - 1)
    let missingHpRatio = 1.0 - (this.getHP() / this.getMaxHP())
    let factor = (missingHpRatio / MAX_BONUS_THRESHOLD).clamp(0.0, 1.0)

    return 1.0 + (getMaxHealAmp(idx) * factor)

function updatePassiveStats()
    let toRemove = new LinkedList<unit>()

    for u in passiveUsers
        if u == null or not u.isAlive() or u.getAbilityLevel(BERSERKERS_FURY) <= 0
            if u != null and u.isAlive()
                // Restore base regeneration rate cleanly
                u.setField(UNIT_RF_HIT_POINTS_REGENERATION_RATE,
                    u.getField(UNIT_RF_HIT_POINTS_REGENERATION_RATE) - lastRegenBonus.get(u))
                // Restore native base attack cooldown speed cleanly
                if baseCooldown.has(u)
                    BlzSetUnitAttackCooldown(u, baseCooldown.get(u), 0)
            toRemove.add(u)
        else
            let lvl = u.getAbilityLevel(BERSERKERS_FURY)
            let idx = (lvl - 1).clamp(0, MAX_LEVELS - 1)

            // 1. Calculate health scaling factor
            let currentHp = u.getHP()
            let maxHp = u.getMaxHP()
            let missingHpRatio = 1.0 - (currentHp / maxHp)
            let factor = (missingHpRatio / MAX_BONUS_THRESHOLD).clamp(0.0, 1.0)

            // 2. Safely capture the original attack speed cooldown value on discovery
            if not baseCooldown.has(u)
                baseCooldown.put(u, BlzGetUnitAttackCooldown(u, 0))

            // 3. Handle Health Regeneration Updates
            let oldRegen = lastRegenBonus.has(u) ? lastRegenBonus.get(u) : 0.0
            let rawBaseRegen = u.getField(UNIT_RF_HIT_POINTS_REGENERATION_RATE) - oldRegen
            let newRegenBonus = getMaxHpRegen(idx) * factor

            u.setField(UNIT_RF_HIT_POINTS_REGENERATION_RATE, rawBaseRegen + newRegenBonus)
            lastRegenBonus.put(u, newRegenBonus)

            // 4. Handle Attack Speed Updates (Decreasing Cooldown Duration = Faster Attacks)
            let nativeCd = baseCooldown.get(u)
            let currentSpeedBonus = getMaxAttackSpeed(idx) * factor
            let targetCd = nativeCd / (1.0 + currentSpeedBonus)
            BlzSetUnitAttackCooldown(u, targetCd, 0)

            // 5. Throttled Live Debug Output System (Runs once every 1.0 seconds / 10 ticks)
            let ticks = debugThrottler.has(u) ? debugThrottler.get(u) : 0
            if ticks >= 10
                debugThrottler.put(u, 0)
                let _hpPercent = (currentHp / maxHp * 100).toString(0)
                let _speedPctStr = (currentSpeedBonus * 100).toString(0)
                // FIX: Changed 'this' to 'u'
                let _healAmpStr = ((u.getHealingMultiplier() - 1.0) * 100).toString(0)
                
                // print("|cffffcc00[Berserker Debug]|r HP: " + hpPercent + "% | +Regen: " + 
                //     newRegenBonus.toString(1) + " HP/s | +Atk Speed: " + speedPctStr + "% | +Heal Amp: " + healAmpStr + "%")
            else
                debugThrottler.put(u, ticks + 1)
            
    for u in toRemove
        passiveUsers.remove(u)
        lastRegenBonus.remove(u)
        baseCooldown.remove(u)
        debugThrottler.remove(u)
    destroy toRemove

// ============================================================================
// INITIALIZATION INITIALIZER
// ============================================================================

init
    registerPlayerUnitEvent(EVENT_PLAYER_HERO_SKILL) ->
        let u = GetLearningUnit()
        if GetLearnedSkill() == BERSERKERS_FURY and not passiveUsers.has(u)
            passiveUsers.add(u)
            lastRegenBonus.put(u, 0.0)
            debugThrottler.put(u, 0)

    doPeriodically(0.10) cb ->
        updatePassiveStats()