package VolJin

import ObjectIdGenerator
import ObjectIds
import UnitIds
import UnitObjEditing
import AbilityIds

import HexingStrike
import HealingWave
import BerserkersFury
import DeathsGrasp
import BloodPact

public constant VOLJIN_ID = compiletime(UNIT_ID_GEN.next())

@compiletime function gen()
  new HeroDefinition(UnitIds.shadowhunter, UnitIds.shadowhunter)
    ..setNormalAbilities(commaList(HEXING_STRIKE_ABIL, AbilityIds.inventory ))
    ..setHeroAbilities(commaList(HEALING_WAVE, BERSERKERS_FURY, DEATHS_GRASP, BLOOD_PACT))
    ..setManaRegeneration(20)
    ..setAgilityPerLevel(4)
    ..setIntelligencePerLevel(3)
    ..setStrengthPerLevel(4)
    ..setGoldCost(50)
    ..setLumberCost(0)
    ..setBuildTime(5)
    ..setProperNames("Vol'jin")
    ..setProperNamesUsed(1)
