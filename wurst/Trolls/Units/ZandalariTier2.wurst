package ZandalariTier2

import UnitObjEditing
import ObjectIdGenerator
import ObjectIds
import Icons

import ZandalariBaseUpgrades
import ZandalariUpgradeCenter
import ZandalariWitchDoctorUpgrade
import ZandalariWitchDoctorSpells
import ZandalariTownHallID
import UnitIds

import ZandalariEnsnare

public constant ZANDALARI_SIEGE_ID   = compiletime(UNIT_ID_GEN.next())
public constant ZANDALARI_HEALER_ID  = compiletime(UNIT_ID_GEN.next())
public constant ZANDALARI_CAVALRY_ID = compiletime(UNIT_ID_GEN.next())
public constant ZANDALARI_FLYER_ID   = compiletime(UNIT_ID_GEN.next())


@compiletime function genZandalariTier2Units()

    // -------------------------------------------------------------------------
    // 1. SIEGE UNIT: THUNDERING DEMOLISHER
    // -------------------------------------------------------------------------
    new UnitDefinition(ZANDALARI_SIEGE_ID, 'ocat')
        ..setName("Thundering Demolisher")
        ..setTooltipBasic("Train Thundering Demolisher")
        ..setTooltipExtended("Heavy armored siege engine reinforced with golden plating. Fires massive, fire-tipped boulders to shatter enemy structures from afar.")
        ..setIconGameInterface(Icons.bTNDemolisher)
        
        ..setGoldCost(70)
        ..setLumberCost(0)
        ..setBuildTime(5)  
        ..setFoodCost(3)
        
        ..setUpgradesUsed(commaList(
            ZANDALARI_DAMAGE_UPG_ID, 
            ZANDALARI_ARMOR_UPG_ID, 
            ZANDALARI_REGEN_UPG_ID
        ))
        ..setRequirements(commaList(ZANDALARI_UPGRADE_CENTER_ID, ZANDALARI_T2_ID))


    // -------------------------------------------------------------------------
    // 2. TROLL HEALER UNIT: ZANCHUL WARD-WEAVER
    // -------------------------------------------------------------------------
    new UnitDefinition(ZANDALARI_HEALER_ID, 'odoc')
        ..setName("Witch Doctor")
        ..setTooltipBasic("Train Witch Doctor")
        ..setTooltipExtended("Spiritual mystic of the council caste. Commands deep voodoo mojo to place healing wards and cast protective enchantments over injured allies.")
        ..setIconGameInterface(Icons.bTNWitchDoctor)
        ..setNormalAbilities(commaList(STASIS_TRAP_ID,HEALING_WARD_ID))
        ..setHotkey("Q")
        ..setButtonPositionX(0)
        ..setButtonPositionY(0)

        ..setGoldCost(55)
        ..setLumberCost(0)
        ..setBuildTime(4)
        ..setFoodCost(2)
        
        ..setUpgradesUsed(commaList(
            ZANDALARI_DAMAGE_UPG_ID, 
            ZANDALARI_ARMOR_UPG_ID, 
            ZANDALARI_REGEN_UPG_ID,
            ZANDALARI_WITCHDOCTOR_UPG_ID
        ))

    // -------------------------------------------------------------------------
    // 3. LIGHT CAVALRY UNIT: RAPTOR OUTRIDER
    // -------------------------------------------------------------------------
    // https://www.hiveworkshop.com/threads/elite-darkspear-troll-rider.334472/
    new UnitDefinition(ZANDALARI_CAVALRY_ID, 'orai') // Inherits Orc Raider ground-cavalry movement/attack properties
        ..setName("Raptor Outrider")
        ..setTooltipBasic("Train Raptor Outrider")
        ..setTooltipExtended("Blistering fast skirmish cavalry mounted on a vicious Zandalari raptor. Specializes in flanking maneuvers and tracking fleeing targets.")
        ..setIconGameInterface("ReplaceableTextures\\CommandButtons\\BTNTigerSharkRider.blp")
        ..setUnitSoundSet("ForestTroll")
        ..setNormalAbilities(commaList(ZANDALARI_ENSNARE))
        ..setModelFile("EliteHeadhunterScoutAWRV2.mdx")
        
        ..setGoldCost(55)
        ..setLumberCost(0)
        ..setBuildTime(4)
        ..setFoodCost(3)
        
        ..setUpgradesUsed(commaList(
            ZANDALARI_DAMAGE_UPG_ID, 
            ZANDALARI_ARMOR_UPG_ID, 
            ZANDALARI_REGEN_UPG_ID
        ))
    // -------------------------------------------------------------------------
    // 3. LIGHT AIR UNIT: Pterrodax Rider
    // -------------------------------------------------------------------------
    // https://www.hiveworkshop.com/threads/zandalari-troll-pterrodax-rider.353747/
    new UnitDefinition(ZANDALARI_FLYER_ID, UnitIds.windrider) // Inherits flying & rider baselines from the Batrider
      ..setName("Pterrodax Rider")
      ..setTooltipBasic("Train Pterrodax Rider")
      ..setTooltipExtended("Swoops over the battlefield to rain down explosive jars of burning resin. Masters of aerial reconnaissance. Can only attack ground units.")
      ..setIconGameInterface("ReplaceableTextures\\CommandButtons\\BTNOwlrider.blp")
      ..setModelFile("Green_dax_rider.mdx")
      
      ..setAttacksEnabled(1)
      ..setAttack1TargetsAllowed("ground,debris,item,ward,structure")
      
      ..setNormalAbilities("") 
      
      ..setGoldCost(60)
      ..setLumberCost(0)
      ..setBuildTime(4)
      ..setFoodCost(3)
      
      ..setUpgradesUsed(commaList(
          ZANDALARI_DAMAGE_UPG_ID, 
          ZANDALARI_ARMOR_UPG_ID, 
          ZANDALARI_REGEN_UPG_ID
      ))

        ..setRequirements(commaList(ZANDALARI_UPGRADE_CENTER_ID))
