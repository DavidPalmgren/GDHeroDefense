package ZandalariWitchDoctorUpgrade

import UpgradeObjEditing
import ObjectIdGenerator
import Icons
import ObjectIds

import ZandalariTownHallID

// Generate Unique IDs for the global upgrade keys
public constant ZANDALARI_WITCHDOCTOR_UPG_ID = compiletime(UPGD_ID_GEN.next())


@compiletime function genZandalariUpgrades()
    
    // -------------------------------------------------------------------------
    // 1. DAMAGE UPGRADE: ZANDALARI GOLDEN BLADES
    // -------------------------------------------------------------------------
    new UpgradeDefinition(ZANDALARI_WITCHDOCTOR_UPG_ID, 2)
        // Cost Setup (Base 50g, +50g per level | 0 Lumber)
        ..setGoldCostBase(50)
        ..setGoldCostIncrement(50)
        ..setLumberCostBase(0)
        ..setLumberCostIncrement(0)
        // Pacing Setup (Base 60s, +60s per level)
        ..setTimeBase(45)
        ..setTimeIncrement(60)
        // Stat Scaling (+3 Base Damage, +3 per level)
        ..addEffectManaPointBonus(100,100)
        ..addEffectManaRegeneration(0.325, 0.325)
        ..addEffectHitPointBonus(50, 50)
        ..addEffectAttackDiceBonus(1, 1)
        ..setIcon(1, Icons.bTNWitchDoctorAdept)
        ..setIcon(2, Icons.bTNWitchDoctorMaster)
        ..setRequirements(1, "")
        ..setRequirements(2, commaList(ZANDALARI_T3_ID))

        ..setClass(UpgradeClass.Melee)
        ..setName(1, "Witch Doctor Adept Training")
        ..setName(2, "Witch Doctor Master Training")
        ..setTooltip(1, "Witch Doctor Adept Training")
        ..setTooltip(2, "Witch Doctor Master Training")
        ..setTooltipExtended(2, "Increases Witch Doctors' mana capacity, mana regeneration rate, hit points, attack dice, and gives them the ability to cast Stasis Trap.")
        ..setTooltipExtended(2, "Increases Witch Doctors' mana capacity, mana regeneration rate, hit points, attack dice, and gives them the ability to cast Healing Ward.")