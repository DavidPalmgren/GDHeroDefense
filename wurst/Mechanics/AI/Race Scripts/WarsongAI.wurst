package WarsongAI
import ControlPoint
import AI
import ClosureTimers
import HPAUnitController
import LinkedList
import HPARoadmap

// Using Player(id) instead of players[id] to prevent potential syntax array errors
public bool event_flag_astranaar = false
public bool event_flag_warsongLumber = false


rect spawn1 = gg_rct_Astranaar1
rect spawn2 = gg_rct_Astranaar2
rect warsongLumber = gg_rct_WarsongLumberCamp
rect warsongFrontline = gg_rct_WarsongFrontline
rect warsongBackline = gg_rct_WarsongBackline
rect barrensGate = gg_rct_BarrensGate
rect barrensGate2 = gg_rct_BarrensGate2
rect warsongNordrassil = gg_rct_NordrassilAttackWarsong
region warsongLumberRegion = CreateRegion()
public LinkedList<destructable> barrensGates = new LinkedList<destructable>()
public group warsong1 = CreateGroup()
public group warsong2 = CreateGroup()
public group warsong3 = CreateGroup()


function checkWarsongTrigger()
    let u = GetEnteringUnit()
    if not event_flag_warsongLumber
        if warsongLumber.contains(u.getPos()) and u.getOwner() != players[5]
            event_flag_warsongLumber = true
            print("Grom Hellscream: The |cffff9900Warsong|r will never fall!")
            spawnWave(Player(5), u.getOwner(), 'nchg', 10, warsong2, warsongFrontline.getCenter())
            spawnWave(Player(5), u.getOwner(), 'nckb', 2, warsong2, warsongFrontline.getCenter())
            spawnWave(Player(5), u.getOwner(), 'nchw', 10, warsong2, warsongBackline.getCenter())
            //Grom placeholder
            for un in warsong2
                un.issueTargetOrder("attack", u)
        


init
    doPeriodically(10.0) (CallbackPeriodic cb) ->
        if event_flag_astranaar == false
            if udg_ashenvaleAstranaar.getOwner() == Player(18)
                event_flag_astranaar = true
                destroy cb 
                
                // 2. Schedule the actual wave to arrive 30 seconds from now
                doAfter(30.0) ->
                    spawnWave(Player(5), udg_ashenvaleAstranaar.getOwner(), 'owar', 1, warsong1, spawn1.getCenter())
                    spawnWave(Player(5), udg_ashenvaleAstranaar.getOwner(), 'nchg', 4, warsong1, spawn1.getCenter())
                    spawnWave(Player(5), udg_ashenvaleAstranaar.getOwner(), 'nckb', 1, warsong1, spawn1.getCenter())
                    spawnWave(Player(5), udg_ashenvaleAstranaar.getOwner(), 'nchw', 3, warsong1, spawn1.getCenter())
                    spawnWave(Player(5), udg_ashenvaleAstranaar.getOwner(), 'nchr', 3, warsong1, spawn1.getCenter())
                    spawnWave(Player(5), udg_ashenvaleAstranaar.getOwner(), 'nchg', 4, warsong1, spawn2.getCenter())
                    spawnWave(Player(5), udg_ashenvaleAstranaar.getOwner(), 'nckb', 1, warsong1, spawn2.getCenter())
                    spawnWave(Player(5), udg_ashenvaleAstranaar.getOwner(), 'nchw', 3, warsong1, spawn2.getCenter())
                    spawnWave(Player(5), udg_ashenvaleAstranaar.getOwner(), 'nchr', 3, warsong1, spawn2.getCenter())
                    
                    print("Orc Warchief: " + "Glory to the |cffff9900Warsong|r" + "Astranaar will burn!")
                    for u in warsong1
                        attackCp(u,false, players[18])
    

    doAfter(30.0) ->  
        warsongLumberRegion.addRect(warsongLumber)
        let t = CreateTrigger()
            ..registerEnterRegion(warsongLumberRegion, null)
            ..addAction() ->
            checkWarsongTrigger()

    doAfter(1080.0) ->
        print("|cffff9900Warsong|r" + " prepares for a final assault on Teldrassil!")
        doPeriodically(120.0) (CallbackPeriodic cb) ->
            if udg_ashenvaleWarsongCenter.getOwner() == players[5]
                let g = CreateGroup()
                spawnWave(Player(5), players[0], 'nchg', 8, g, warsongNordrassil.getCenter())
                spawnWave(Player(5), players[0], 'nckb', 2, g, warsongNordrassil.getCenter())
                spawnWave(Player(5), players[0], 'nchw', 4, g, warsongNordrassil.getCenter())
                spawnWave(Player(5), players[0], 'nchr', 4, g, warsongNordrassil.getCenter())

                // ONE macro A* for the whole wave (same start + goal):
                let wps = queryRoadWaypoints(warsongNordrassil.getCenter(), udg_mountHyjal.getPos())
                for u in g
                    startHPA_NavigationShared(u, warsongNordrassil.getCenter(), udg_mountHyjal.getPos(), wps,true)
                freeWaypoints(wps)

                g.destr()
            else
                destroy cb
    
    doAfter(30.0) -> 
        doPeriodically(10) (CallbackPeriodic cb) ->
            if udg_ashenvaleWarsongCenter.getOwner() != players[5]
                print("|cffff9900Warsong|r is defeated, the way to the Barrens is clear")
                barrensGate.enumDestructablesInRect(null) ->
                    barrensGates.add(GetEnumDestructable())
                barrensGate2.enumDestructablesInRect(null) ->
                    barrensGates.add(GetEnumDestructable())
                for d in barrensGates
                    KillDestructable(d)
                destroy barrensGates
                destroy cb
        




                
               
        
